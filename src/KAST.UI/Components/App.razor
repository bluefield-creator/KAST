<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <meta name="color-scheme" content="dark light" />
    <link rel="preload" href="lib/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="lib/fonts/Inter-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/caster.css"]" />
    <link rel="stylesheet" href="@Assets["KAST.UI.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="icon" type="image/png" sizes="64x64" href="brand/logo-64.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["lib/chartjs/chart.umd.min.js"]"></script>
    <script>
        window.KAST = {
            scrollToBottom: function (el) {
                if (el) el.scrollTop = el.scrollHeight;
            },
            downloadFile: function (filename, content) {
                var blob = new Blob([content], { type: 'application/json' });
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            },
            scrollToTop: function (el) {
                if (el) el.scrollTop = 0;
            },
            keyboard: {
                init: function (dotNetRef) {
                    this._ref = dotNetRef;
                    this._handler = function (e) {
                        // Ctrl+K / Cmd+K → command palette
                        if ((e.ctrlKey || e.metaKey) && !e.shiftKey && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); dotNetRef.invokeMethodAsync('OnKeyDown', 'ctrl+k'); return; }
                        // Ctrl+Shift+L → toggle-log
                        if (e.ctrlKey && e.shiftKey && e.key === 'L') { e.preventDefault(); dotNetRef.invokeMethodAsync('OnKeyDown', 'ctrl+shift+l'); }
                        // ? → show-shortcuts
                        if (!e.ctrlKey && !e.metaKey && e.key === '?' && !e.target.matches('input,textarea,[contenteditable]')) { e.preventDefault(); dotNetRef.invokeMethodAsync('OnKeyDown', '?'); }
                    };
                    document.addEventListener('keydown', this._handler);
                },
                dispose: function () {
                    if (this._handler) document.removeEventListener('keydown', this._handler);
                }
            }
        };

        window._kastChartInstances = {};

        window.kastCharts = {
            // Resolves "var(--token)suffix" strings against the live theme
            // so chart colours follow light/dark mode without hard-coding.
            _resolveColors: function (node) {
                if (typeof node === 'string') {
                    var m = node.match(/^var\((--[\w-]+)\)(.*)$/);
                    if (m) {
                        var v = getComputedStyle(document.documentElement).getPropertyValue(m[1]).trim();
                        if (!v) return node;
                        // Optional 2-digit hex alpha suffix, e.g. var(--k-info)1A
                        var alpha = /^[0-9a-fA-F]{2}$/.test(m[2]) ? parseInt(m[2], 16) / 255 : null;
                        if (alpha === null) return v + m[2];
                        var rgb = v.match(/^rgba?\(\s*(\d+)[,\s]+(\d+)[,\s]+(\d+)/);
                        if (rgb) return 'rgba(' + rgb[1] + ',' + rgb[2] + ',' + rgb[3] + ',' + alpha.toFixed(3) + ')';
                        if (/^#[0-9a-fA-F]{6}$/.test(v)) return v + m[2];
                        return v;
                    }
                    return node;
                }
                if (Array.isArray(node)) return node.map(window.kastCharts._resolveColors);
                if (node && typeof node === 'object') {
                    for (var k in node) node[k] = window.kastCharts._resolveColors(node[k]);
                }
                return node;
            },
            create: function (id, config) {
                var ctx = document.getElementById(id);
                if (!ctx) return;
                if (window._kastChartInstances[id]) window._kastChartInstances[id].destroy();
                window._kastChartInstances[id] = new Chart(ctx, window.kastCharts._resolveColors(config));
            },
            update: function (id, labels, dataArrays) {
                var chart = window._kastChartInstances[id];
                if (!chart) return;
                chart.data.labels = labels;
                for (var i = 0; i < dataArrays.length; i++) {
                    if (chart.data.datasets[i]) {
                        chart.data.datasets[i].data = dataArrays[i];
                    }
                }
                chart.update('none');
            },
            destroy: function (id) {
                if (window._kastChartInstances[id]) {
                    window._kastChartInstances[id].destroy();
                    delete window._kastChartInstances[id];
                }
            }
        };
    </script>
</body>

</html>
