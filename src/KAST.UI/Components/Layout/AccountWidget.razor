@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserAccountService AccountService
@inject NavigationManager Navigation
@inject ThemeService ThemeService

@if (_user is not null)
{
    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" PopoverClass="k-user-menu">
        <ActivatorContent>
            <button type="button" class="k-appbar-chip" aria-label="Account menu">
                @if (!string.IsNullOrWhiteSpace(_user.AvatarFileName))
                {
                    <img src="@($"/account/avatars/{_user.AvatarFileName}")" alt="" class="k-avatar" />
                }
                else
                {
                    <span class="k-avatar k-avatar-initial">@GetInitial()</span>
                }
                <span class="k-appbar-chip-label">@_user.Username</span>
                <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" />
            </button>
        </ActivatorContent>
        <ChildContent>
            <div class="k-menu-header">
                <div class="k-menu-title">@_user.Username</div>
                <div class="k-menu-subtitle">Administrator</div>
            </div>
            <MudDivider />
            <div class="k-menu-section">Appearance</div>
            <MudMenuItem Icon="@Icons.Material.Outlined.DarkMode" OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.Dark))">
                Dark @(ThemeService.Mode == ThemeMode.Dark ? "✓" : null)
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.LightMode" OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.Light))">
                Light @(ThemeService.Mode == ThemeMode.Light ? "✓" : null)
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.SettingsBrightness" OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.System))">
                Match system @(ThemeService.Mode == ThemeMode.System ? "✓" : null)
            </MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Outlined.ManageAccounts" Href="settings/accounts">Account settings</MudMenuItem>
            <form method="post" action="/auth/logout" data-enhance="false">
                <button type="submit" class="k-menu-button">
                    <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                    Sign out
                </button>
            </form>
        </ChildContent>
    </MudMenu>
}

@code {
    private KastUser? _user;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.GetUserId();
        if (userId is not null)
            _user = await AccountService.GetByIdAsync(userId.Value);
    }

    private string GetInitial()
        => string.IsNullOrWhiteSpace(_user?.Username)
            ? "?"
            : _user.Username.Trim()[0].ToString().ToUpperInvariant();
}
