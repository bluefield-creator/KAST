@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="caster-root caster-dark k-auth">
    <div class="k-auth-panel">
        <div class="k-auth-brand">
            <img src="brand/logo-128.png" alt="" class="k-auth-mark" draggable="false" />
            <div>
                <div class="k-auth-name">CASTER</div>
                <div class="k-auth-tagline">Arma 3 server management</div>
            </div>
        </div>
        @Body
    </div>
</div>

@code {
    private readonly MudTheme _theme = CasterTheme.Build();
}
