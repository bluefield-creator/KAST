@implements IDisposable
@inject KastLogStore LogStore
@inject ISteamService SteamService
@inject MonitoringStateService MonitoringState
@inject KeyboardShortcutService KeyboardShortcuts
@inject IJSRuntime JSRuntime

@if (_isResizing)
{
    <div class="resize-overlay"
         @onmousemove="OnResizeMove" @onmousemove:preventDefault="true"
         @onmouseup="StopResize"></div>
}

<footer class="k-statusbar">
    <div class="k-statusbar-items">
        <span class="k-statusbar-item" title="Web API health"><span class="k-dot @ApiClass(MonitoringState.ApiStatus)"></span>API</span>
        <span class="k-statusbar-item" title="Database"><span class="k-dot @(MonitoringState.IsDbOk ? "k-dot-ok" : "k-dot-err")"></span>Database</span>
        <span class="k-statusbar-item" title="Steam connection">
            <span class="k-dot @(SteamService.IsAuthenticated ? "k-dot-ok" : SteamService.IsConnected ? "k-dot-warn" : "k-dot-err")"></span>
            Steam@(SteamService.IsAuthenticated && SteamService.Profile?.PersonaName != null ? $" · {SteamService.Profile.PersonaName}" : "")
        </span>
        <span class="k-statusbar-item" title="Monitoring"><span class="k-dot @(MonitoringState.IsMonitoringOk ? "k-dot-ok" : "k-dot-err")"></span>Monitoring</span>
        @if (_errorCount > 0)
        {
            <button type="button" class="k-statusbar-errors" @onclick="@(() => { _logOpen = true; _filterLevel = LogLevel.Error; })">
                @_errorCount error@(_errorCount == 1 ? "" : "s")
            </button>
        }
    </div>

    <div class="k-statusbar-right">
        @if (!_logOpen && _lastMessage != "")
        {
            <span class="k-statusbar-last k-mono">@_lastMessage</span>
        }
        <MudTooltip Text="Logs (Ctrl+Shift+L)" Placement="Placement.Top">
            <MudIconButton Icon="@(_logOpen ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.Terminal)"
                           Size="Size.Small" Class="k-statusbar-btn"
                           Color="@(_errorCount > 0 ? Color.Error : (_logOpen ? Color.Primary : Color.Default))"
                           OnClick="@(() => _logOpen = !_logOpen)" aria-label="Toggle log panel" />
        </MudTooltip>
    </div>
</footer>

@if (_logOpen)
{
    <aside class="log-panel" style="width:@(_panelWidth)px;" aria-label="Application log">
        <div class="resize-handle" @onmousedown="StartResize" @onmousedown:preventDefault="true" title="Drag to resize"></div>

        <div class="log-toolbar">
            <span class="log-title">Application log</span>
            <MudSpacer />
            @foreach (var item in _filterOptions)
            {
                <button type="button"
                        class="log-filter @LevelClass(item.Level) @(_filterLevel == item.Level ? "active" : null)"
                        title="Show @item.Label and above"
                        @onclick="@(() => _filterLevel = (_filterLevel == item.Level ? null : (LogLevel?)item.Level))">
                    @item.Label
                </button>
            }
            <MudIconButton Icon="@Icons.Material.Outlined.VerticalAlignTop" Size="Size.Small" aria-label="Jump to top" OnClick="@ScrollToTop" />
            <MudIconButton Icon="@Icons.Material.Outlined.DeleteSweep" Size="Size.Small" aria-label="Clear log" OnClick="@(() => LogStore.Clear())" />
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="Close log panel" OnClick="@(() => _logOpen = false)" />
        </div>

        <div @ref="_logScrollRef" class="log-output kast-log-console">
            @{
                var entries = GetFilteredEntries();
            }
            @if (entries.Count == 0)
            {
                <span class="log-empty">No log entries.</span>
            }
            @foreach (var entry in entries)
            {
                <div class="log-entry">
                    <span class="log-timestamp">@entry.Timestamp.ToString("HH:mm:ss.fff")</span>
                    <span class="log-level @LevelClass(entry.Level)">@GetLevelTag(entry.Level)</span>
                    <span class="log-category" title="@entry.Category">@ShortCategory(entry.Category)</span>
                    <span class="log-message">@entry.Message</span>
                </div>
            }
        </div>
    </aside>
}

@code {
    private bool _logOpen;
    private LogLevel? _filterLevel;
    private bool _disposed;
    private string _lastMessage = "";
    private int _errorCount;
    private bool _scrollNeeded;
    private ElementReference _logScrollRef;

    // ── Resizable panel ─────────────────────────────────────────────
    private int _panelWidth = 560;
    private const int MinPanelWidth = 320;
    private const int MaxPanelWidth = 1400;
    private bool _isResizing;
    private double _resizeStartX;
    private int _resizeStartWidth;

    private void StartResize(MouseEventArgs e)
    {
        _isResizing = true;
        _resizeStartX = e.ClientX;
        _resizeStartWidth = _panelWidth;
    }

    private void OnResizeMove(MouseEventArgs e)
    {
        if (!_isResizing) return;
        _panelWidth = Math.Clamp((int)(_resizeStartWidth + (_resizeStartX - e.ClientX)), MinPanelWidth, MaxPanelWidth);
    }

    private void StopResize(MouseEventArgs e)
    {
        _isResizing = false;
    }

    private static readonly (string Label, LogLevel Level)[] _filterOptions =
    [
        ("TRC", LogLevel.Trace),
        ("DBG", LogLevel.Debug),
        ("INF", LogLevel.Information),
        ("WRN", LogLevel.Warning),
        ("ERR", LogLevel.Error)
    ];

    protected override void OnInitialized()
    {
        KeyboardShortcuts.Register("ctrl+shift+l", () => InvokeAsync(() =>
        {
            _logOpen = !_logOpen;
            StateHasChanged();
        }));
        MonitoringState.EnsureStarted();
        MonitoringState.OnDataChanged += HandleMonitoringChanged;
        LogStore.OnNewEntry += OnNewLog;
        SteamService.AuthStateChanged += OnServiceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollNeeded && _logOpen)
        {
            _scrollNeeded = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("KAST.scrollToBottom", _logScrollRef);
            }
            catch { }
        }
    }

    private IReadOnlyList<AppLogEntry> GetFilteredEntries()
    {
        var all = LogStore.GetAll();
        return _filterLevel is null ? all : all.Where(e => e.Level >= _filterLevel.Value).ToArray();
    }

    private void HandleMonitoringChanged() => InvokeAsync(StateHasChanged);

    private void OnNewLog()
    {
        if (_disposed) return;
        var all = LogStore.GetAll();
        _lastMessage = all.LastOrDefault()?.Message ?? "";
        _errorCount = all.Count(e => e.Level >= LogLevel.Error);
        _scrollNeeded = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnServiceChanged()
    {
        if (_disposed) return;
        InvokeAsync(StateHasChanged);
    }

    private async Task ScrollToTop()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("KAST.scrollToTop", _logScrollRef);
        }
        catch { }
    }

    private static string GetLevelTag(LogLevel l) => l switch
    {
        LogLevel.Trace => "TRC",
        LogLevel.Debug => "DBG",
        LogLevel.Information => "INF",
        LogLevel.Warning => "WRN",
        LogLevel.Error => "ERR",
        LogLevel.Critical => "CRT",
        _ => "???"
    };

    private static string LevelClass(LogLevel? l) => l switch
    {
        LogLevel.Trace       => "lvl-trace",
        LogLevel.Debug       => "lvl-debug",
        LogLevel.Information => "lvl-info",
        LogLevel.Warning     => "lvl-warn",
        LogLevel.Error or LogLevel.Critical => "lvl-error",
        _                    => "lvl-debug",
    };

    private static string ShortCategory(string cat) =>
        cat.Contains('.') ? cat[(cat.LastIndexOf('.') + 1)..] : cat;

    private static string ApiClass(Microsoft.Extensions.Diagnostics.HealthChecks.HealthStatus status) => status switch
    {
        Microsoft.Extensions.Diagnostics.HealthChecks.HealthStatus.Healthy => "k-dot-ok",
        Microsoft.Extensions.Diagnostics.HealthChecks.HealthStatus.Degraded => "k-dot-warn",
        _ => "k-dot-err"
    };

    public void Dispose()
    {
        _disposed = true;
        MonitoringState.OnDataChanged -= HandleMonitoringChanged;
        LogStore.OnNewEntry -= OnNewLog;
        SteamService.AuthStateChanged -= OnServiceChanged;
    }
}
