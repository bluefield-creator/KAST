@inherits LayoutComponentBase
@implements IAsyncDisposable
@using KAST.UI.Themes

@inject ThemeService ThemeService
@inject KeyboardShortcutService KeyboardShortcuts

<MudThemeProvider @ref="_themeProvider" Theme="@_theme" IsDarkMode="@ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="caster-root @(ThemeService.IsDarkMode ? "caster-dark" : "caster-light")">
    <MudLayout>
        <MudAppBar Elevation="0">
            <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Toggle navigation" />
            <a href="" class="k-brand" aria-label="CASTER home">
                <img src="brand/logo-64.png" alt="" class="k-brand-mark" draggable="false" />
                <span class="k-brand-name">CASTER</span>
            </a>
            <MudSpacer />
            <CommandPaletteButton />
            <SteamAccountWidget />
            <AccountWidget />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Breakpoint="Breakpoint.Md">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <div class="k-page">
                @Body
            </div>
        </MudMainContent>

        <FooterBar />
    </MudLayout>

    <CommandPalette @bind-Open="_paletteOpen" />

    @if (_showShortcutsHelp)
    {
        <MudOverlay Visible="true" OnClick="@(() => _showShortcutsHelp = false)" DarkBackground="true" ZIndex="2000">
            <MudPaper Class="k-shortcuts pa-5" Elevation="8" @onclick:stopPropagation="true">
                <MudText Typo="Typo.h6" Class="mb-3">Keyboard shortcuts</MudText>
                <dl class="k-shortcuts-list">
                    <dt><kbd>Ctrl</kbd> <kbd>K</kbd></dt><dd>Command palette</dd>
                    <dt><kbd>Ctrl</kbd> <kbd>Shift</kbd> <kbd>L</kbd></dt><dd>Toggle the log panel</dd>
                    <dt><kbd>?</kbd></dt><dd>Show this help</dd>
                </dl>
                <div class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Text" OnClick="@(() => _showShortcutsHelp = false)">Close</MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    private readonly MudTheme _theme = CasterTheme.Build();
    private MudThemeProvider? _themeProvider;
    private bool _drawerOpen = true;
    private bool _paletteOpen;
    private bool _showShortcutsHelp;

    protected override void OnInitialized()
    {
        ThemeService.OnChange += OnThemeChanged;
        KeyboardShortcuts.OpenCommandPalette += OnOpenCommandPalette;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await ThemeService.InitializeAsync();

        if (_themeProvider is not null)
        {
            try
            {
                ThemeService.SetSystemPreference(await _themeProvider.GetSystemDarkModeAsync());
                await _themeProvider.WatchSystemDarkModeAsync(prefersDark =>
                {
                    ThemeService.SetSystemPreference(prefersDark);
                    return Task.CompletedTask;
                });
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or InvalidOperationException)
            {
                // Circuit going away; nothing to follow.
            }
        }

        await KeyboardShortcuts.InitializeAsync();
        KeyboardShortcuts.Register("?", async () =>
        {
            _showShortcutsHelp = true;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnOpenCommandPalette() => InvokeAsync(() =>
    {
        _paletteOpen = true;
        StateHasChanged();
    });

    public ValueTask DisposeAsync()
    {
        ThemeService.OnChange -= OnThemeChanged;
        KeyboardShortcuts.OpenCommandPalette -= OnOpenCommandPalette;
        return ValueTask.CompletedTask;
    }
}
