@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav
@inject KastInternalUrlProvider InternalUrls
@inject KAST.UI.Services.InternalHubTokenService HubToken
@inject ILogger<NavMenu> Logger
@inject IServerInstanceService ServerService
@inject KAST.UI.Services.MonitoringSnapshotService Snapshots
@implements IAsyncDisposable

@* Dense, edge-to-edge navigation: grouped sections, one 32px row per
   destination, icon + label + trailing meta, in-place sub-rows for
   instances and Settings tabs. Active rows wear the brass rail. *@
<nav class="k-nav" aria-label="Main navigation">

    <div class="k-nav-group">
        <div class="k-nav-group-label">Terminal</div>
        <NavLink href="" Match="NavLinkMatch.All" class="k-nav-row" ActiveClass="active">
            <MudIcon Icon="@Icons.Material.Outlined.SpaceDashboard" Class="k-nav-icon" />
            <span class="k-nav-label">Dashboard</span>
        </NavLink>
    </div>

    <div class="k-nav-group">
        <div class="k-nav-group-label">Garrison</div>
        <NavLink href="servers" Match="NavLinkMatch.All" class="k-nav-row" ActiveClass="active">
            <MudIcon Icon="@Icons.Material.Outlined.Dns" Class="k-nav-icon" />
            <span class="k-nav-label">Servers</span>
            <span class="k-nav-meta">
                @if (RunningCount > 0)
                {
                    <span class="k-nav-badge k-nav-badge-live" title="@RunningCount running">@RunningCount</span>
                }
                <span class="k-nav-count">@_servers.Count</span>
            </span>
        </NavLink>

        @if (_servers.Count > 5)
        {
            <div class="k-nav-filter">
                <MudTextField @bind-Value="_serverFilter"
                              Placeholder="Filter instances"
                              Immediate="true"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Default" />
            </div>
        }
        @foreach (var s in GetFilteredServers())
        {
            <NavLink href="@($"servers/{s.Id}")" Match="NavLinkMatch.All" class="k-nav-row k-nav-row-sub" ActiveClass="active">
                <span class="k-nav-status k-nav-status-@s.Status.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                <span class="k-nav-label">@s.Name</span>
                <span class="k-nav-meta k-nav-mono">@GetPlayerSuffix(s)</span>
            </NavLink>
        }
        <NavLink href="servers/new" Match="NavLinkMatch.All" class="k-nav-row k-nav-row-sub k-nav-row-action" ActiveClass="active">
            <MudIcon Icon="@Icons.Material.Outlined.Add" Class="k-nav-icon k-nav-icon-sm" />
            <span class="k-nav-label">New instance</span>
        </NavLink>
    </div>

    <div class="k-nav-group">
        <div class="k-nav-group-label">Armoury</div>
        <NavLink href="mods" Match="NavLinkMatch.Prefix" class="k-nav-row" ActiveClass="active">
            <MudIcon Icon="@Icons.Material.Outlined.Extension" Class="k-nav-icon" />
            <span class="k-nav-label">Mods</span>
        </NavLink>
    </div>

    <div class="k-nav-group">
        <div class="k-nav-group-label">Watchtower</div>
        <NavLink href="monitoring" Match="NavLinkMatch.Prefix" class="k-nav-row" ActiveClass="active">
            <MudIcon Icon="@Icons.Material.Outlined.Insights" Class="k-nav-icon" />
            <span class="k-nav-label">Monitoring</span>
            @if (_monitoringUnavailable)
            {
                <span class="k-nav-meta"><span class="k-nav-badge k-nav-badge-warn" title="Monitoring unavailable">!</span></span>
            }
        </NavLink>
    </div>

    <div class="k-nav-group">
        <div class="k-nav-group-label">Standing Orders</div>
        <NavLink href="settings" Match="NavLinkMatch.Prefix" class="k-nav-row" ActiveClass="active">
            <MudIcon Icon="@Icons.Material.Outlined.Tune" Class="k-nav-icon" />
            <span class="k-nav-label">Settings</span>
        </NavLink>
        @foreach (var (tab, label) in SettingsTabs)
        {
            <a href="@(tab is null ? "settings" : $"settings?tab={tab}")"
               class="k-nav-row k-nav-row-sub @(IsSettingsTabActive(tab) ? "active" : null)">
                <span class="k-nav-tick" aria-hidden="true"></span>
                <span class="k-nav-label">@label</span>
            </a>
        }
    </div>

    <div class="k-nav-group">
        <div class="k-nav-group-label">Archive</div>
        <NavLink href="about" Match="NavLinkMatch.Prefix" class="k-nav-row" ActiveClass="active">
            <MudIcon Icon="@Icons.Material.Outlined.Info" Class="k-nav-icon" />
            <span class="k-nav-label">About</span>
        </NavLink>
    </div>

</nav>

@code {
    private IReadOnlyList<ServerInstance> _servers = [];
    private string _serverFilter = string.Empty;

    private static readonly (string? Tab, string Label)[] SettingsTabs =
    [
        (null,       "General"),
        ("accounts", "Accounts"),
        ("steam",    "Steam"),
        ("api-keys", "API keys"),
        ("service",  "Service"),
        ("updates",  "Updates"),
    ];

    private int RunningCount => _servers.Count(s => s.Status == ServerInstanceStatus.Running);
    private HubConnection? _hub;
    private bool _monitoringUnavailable;

    private IEnumerable<ServerInstance> GetFilteredServers()
    {
        if (string.IsNullOrWhiteSpace(_serverFilter))
            return _servers;

        return _servers.Where(s =>
            s.Name.Contains(_serverFilter, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// NavLink ignores the query string, so Settings sub-rows resolve their
    /// own active state from the current <c>?tab=</c> value.
    /// </summary>
    private bool IsSettingsTabActive(string? tab)
    {
        var uri = new Uri(Nav.Uri);
        if (!Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/').Equals("settings", StringComparison.OrdinalIgnoreCase))
            return false;

        var current = System.Web.HttpUtility.ParseQueryString(uri.Query)["tab"];
        return tab is null ? string.IsNullOrEmpty(current) : string.Equals(current, tab, StringComparison.OrdinalIgnoreCase);
    }

    private string GetPlayerSuffix(ServerInstance server)
    {
        if (server.Status != ServerInstanceStatus.Running)
            return "";

        var metrics = Snapshots.Current.InstanceMetrics.FirstOrDefault(m => m.ServerInstanceId == server.Id);
        if (metrics is null)
            return "";

        return metrics.MaxPlayers > 0
            ? $"{metrics.PlayerCount}/{metrics.MaxPlayers}"
            : $"{metrics.PlayerCount}";
    }

    private void OnSnapshotChanged()
        => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        Nav.LocationChanged += OnLocationChanged;
        Snapshots.Changed += OnSnapshotChanged;

        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(InternalUrls.GetMonitoringHubUri(), options =>
                    options.Headers.Add(KAST.UI.Services.InternalHubAuthenticationDefaults.HeaderName, HubToken.Token))
                .WithAutomaticReconnect()
                .Build();

            _hub.Reconnecting += _ =>
            {
                _monitoringUnavailable = true;
                return InvokeAsync(StateHasChanged);
            };

            _hub.Reconnected += async _ =>
            {
                _monitoringUnavailable = false;
                // Group membership is per-connection; re-join after a reconnect
                await _hub.InvokeAsync("SubscribeToServerStatus");
                await InvokeAsync(StateHasChanged);
            };

            _hub.Closed += error =>
            {
                _monitoringUnavailable = true;
                if (error is not null)
                    Logger.LogWarning(error, "Monitoring SignalR hub connection closed.");
                return InvokeAsync(StateHasChanged);
            };

            _hub.On<ServerStatusChangedEvent>("ServerStatusChanged", async _ =>
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            });

            await _hub.StartAsync();
            await _hub.InvokeAsync("SubscribeToServerStatus");
            _monitoringUnavailable = false;
        }
        catch (Exception ex)
        {
            _monitoringUnavailable = true;
            Logger.LogWarning(ex, "Failed to connect to monitoring SignalR hub.");
            if (_hub is not null)
            {
                await _hub.DisposeAsync();
                _hub = null;
            }
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // An unhandled exception in an async-void handler would terminate
            // the Blazor circuit — log and continue instead.
            Logger.LogWarning(ex, "Failed to refresh navigation state after location change");
        }
    }

    private async Task RefreshAsync()
    {
        _servers = await ServerService.GetAllInstancesAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Snapshots.Changed -= OnSnapshotChanged;
        if (_hub is not null) await _hub.DisposeAsync();
    }

}
