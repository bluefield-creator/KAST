@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav
@inject KastInternalUrlProvider InternalUrls
@inject KAST.UI.Services.InternalHubTokenService HubToken
@inject ILogger<NavMenu> Logger
@inject IServerInstanceService ServerService
@inject KAST.UI.Services.MonitoringSnapshotService Snapshots
@implements IAsyncDisposable

@* Themed banner navigation — each destination is a skewed banner plate:
   kicker, serif title, one domed fitting. The active banner wears the
   brass rail and the crimson hem. *@
<nav class="fgo-nav" aria-label="Main navigation">

    <NavLink href="" Match="NavLinkMatch.All" class="fgo-banner" ActiveClass="active">
        <span class="fgo-banner-inner">
            <span class="fgo-banner-text">
                <span class="fgo-kicker">Terminal</span>
                <span class="fgo-title">Dashboard</span>
            </span>
            <span class="fgo-fitting" aria-hidden="true"></span>
        </span>
    </NavLink>

    <NavLink href="servers" Match="NavLinkMatch.Prefix" class="fgo-banner" ActiveClass="active">
        <span class="fgo-banner-inner">
            <span class="fgo-banner-text">
                <span class="fgo-kicker">Garrison</span>
                <span class="fgo-title">Servers</span>
            </span>
            @if (RunningCount > 0)
            {
                <span class="fgo-badge fgo-badge-live">@RunningCount</span>
            }
            <span class="fgo-fitting" aria-hidden="true"></span>
        </span>
    </NavLink>

    @if (_servers.Count > 0)
    {
        <div class="fgo-sub-nav">
            @if (_servers.Count > 5)
            {
                <MudTextField @bind-Value="_serverFilter"
                              Placeholder="Filter servers..."
                              Immediate="true"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Default"
                              Class="pa-2" />
            }
            @foreach (var s in GetFilteredServers())
            {
                <NavLink href="@($"servers/{s.Id}")" Match="NavLinkMatch.All" class="fgo-banner fgo-banner-sub" ActiveClass="active">
                    <span class="fgo-banner-inner">
                        <span class="fgo-status fgo-status-@s.Status.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                        <span class="fgo-sub-name">@s.Name</span>
                        <span class="fgo-sub-players">@GetPlayerSuffix(s)</span>
                    </span>
                </NavLink>
            }
        </div>
    }

    <NavLink href="mods" Match="NavLinkMatch.Prefix" class="fgo-banner" ActiveClass="active">
        <span class="fgo-banner-inner">
            <span class="fgo-banner-text">
                <span class="fgo-kicker">Armoury</span>
                <span class="fgo-title">Mods</span>
            </span>
            <span class="fgo-fitting" aria-hidden="true"></span>
        </span>
    </NavLink>

    <NavLink href="monitoring" Match="NavLinkMatch.Prefix" class="fgo-banner" ActiveClass="active">
        <span class="fgo-banner-inner">
            <span class="fgo-banner-text">
                <span class="fgo-kicker">Watchtower</span>
                <span class="fgo-title">Monitoring</span>
            </span>
            @if (_monitoringUnavailable)
            {
                <span class="fgo-badge fgo-badge-warn" title="Monitoring unavailable">!</span>
            }
            <span class="fgo-fitting" aria-hidden="true"></span>
        </span>
    </NavLink>

    <NavLink href="settings" Match="NavLinkMatch.Prefix" class="fgo-banner" ActiveClass="active">
        <span class="fgo-banner-inner">
            <span class="fgo-banner-text">
                <span class="fgo-kicker">Standing Orders</span>
                <span class="fgo-title">Settings</span>
            </span>
            <span class="fgo-fitting" aria-hidden="true"></span>
        </span>
    </NavLink>

    <NavLink href="about" Match="NavLinkMatch.Prefix" class="fgo-banner" ActiveClass="active">
        <span class="fgo-banner-inner">
            <span class="fgo-banner-text">
                <span class="fgo-kicker">Archive</span>
                <span class="fgo-title">About</span>
            </span>
            <span class="fgo-fitting" aria-hidden="true"></span>
        </span>
    </NavLink>

</nav>

@code {
    private IReadOnlyList<ServerInstance> _servers = [];
    private string _serverFilter = string.Empty;

    private int RunningCount => _servers.Count(s => s.Status == ServerInstanceStatus.Running);
    private HubConnection? _hub;
    private bool _monitoringUnavailable;

    private IEnumerable<ServerInstance> GetFilteredServers()
    {
        if (string.IsNullOrWhiteSpace(_serverFilter))
            return _servers;

        return _servers.Where(s =>
            s.Name.Contains(_serverFilter, StringComparison.OrdinalIgnoreCase));
    }

    private string GetPlayerSuffix(ServerInstance server)
    {
        if (server.Status != ServerInstanceStatus.Running)
            return "";

        var metrics = Snapshots.Current.InstanceMetrics.FirstOrDefault(m => m.ServerInstanceId == server.Id);
        if (metrics is null)
            return "";

        return metrics.MaxPlayers > 0
            ? $"  ({metrics.PlayerCount}/{metrics.MaxPlayers})"
            : $"  ({metrics.PlayerCount})";
    }

    private void OnSnapshotChanged()
        => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        Nav.LocationChanged += OnLocationChanged;
        Snapshots.Changed += OnSnapshotChanged;

        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(InternalUrls.GetMonitoringHubUri(), options =>
                    options.Headers.Add(KAST.UI.Services.InternalHubAuthenticationDefaults.HeaderName, HubToken.Token))
                .WithAutomaticReconnect()
                .Build();

            _hub.Reconnecting += _ =>
            {
                _monitoringUnavailable = true;
                return InvokeAsync(StateHasChanged);
            };

            _hub.Reconnected += async _ =>
            {
                _monitoringUnavailable = false;
                // Group membership is per-connection; re-join after a reconnect
                await _hub.InvokeAsync("SubscribeToServerStatus");
                await InvokeAsync(StateHasChanged);
            };

            _hub.Closed += error =>
            {
                _monitoringUnavailable = true;
                if (error is not null)
                    Logger.LogWarning(error, "Monitoring SignalR hub connection closed.");
                return InvokeAsync(StateHasChanged);
            };

            _hub.On<ServerStatusChangedEvent>("ServerStatusChanged", async _ =>
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            });

            await _hub.StartAsync();
            await _hub.InvokeAsync("SubscribeToServerStatus");
            _monitoringUnavailable = false;
        }
        catch (Exception ex)
        {
            _monitoringUnavailable = true;
            Logger.LogWarning(ex, "Failed to connect to monitoring SignalR hub.");
            if (_hub is not null)
            {
                await _hub.DisposeAsync();
                _hub = null;
            }
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // An unhandled exception in an async-void handler would terminate
            // the Blazor circuit — log and continue instead.
            Logger.LogWarning(ex, "Failed to refresh navigation state after location change");
        }
    }

    private async Task RefreshAsync()
    {
        _servers = await ServerService.GetAllInstancesAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Snapshots.Changed -= OnSnapshotChanged;
        if (_hub is not null) await _hub.DisposeAsync();
    }

}
