@inject ISteamService SteamService
@inject NavigationManager Navigation
@implements IDisposable

<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" PopoverClass="k-user-menu">
    <ActivatorContent>
        <button type="button" class="k-appbar-chip" aria-label="Steam account">
            @if (SteamService.IsAuthenticated && !string.IsNullOrEmpty(SteamService.Profile?.AvatarUrl))
            {
                <img src="@SteamService.Profile!.AvatarUrl" alt="" class="k-avatar" />
            }
            else
            {
                <MudIcon Icon="@CasterIcons.Steam" Size="Size.Small" />
            }
            <span class="k-dot @(SteamService.IsAuthenticated ? "k-dot-ok" : SteamService.IsConnected ? "k-dot-warn" : "k-dot-err")"></span>
            <span class="k-appbar-chip-label">@DisplayName</span>
        </button>
    </ActivatorContent>
    <ChildContent>
        @if (SteamService.IsAuthenticated)
        {
            <div class="k-menu-header">
                <div class="k-menu-title">@(SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername)</div>
                @if (!string.IsNullOrEmpty(SteamService.CurrentUsername) && SteamService.Profile?.PersonaName != SteamService.CurrentUsername)
                {
                    <div class="k-menu-subtitle">@SteamService.CurrentUsername</div>
                }
                @if (SteamService.Profile?.SteamId > 0)
                {
                    <div class="k-menu-subtitle k-mono">@SteamService.Profile.SteamId</div>
                }
            </div>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Outlined.Settings" Href="settings/steam">Steam settings</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="Logout">Sign out of Steam</MudMenuItem>
        }
        else
        {
            <div class="k-menu-header">
                <div class="k-menu-title">Steam</div>
                <div class="k-menu-subtitle">Not signed in. Sign in to download mods and server files.</div>
            </div>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Outlined.Login" Href="settings/steam">Sign in with Steam</MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    private string DisplayName => SteamService.IsAuthenticated
        ? SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername ?? "Steam"
        : "Steam";

    protected override void OnInitialized() => SteamService.AuthStateChanged += OnAuthStateChanged;

    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);

    private async Task Logout() => await SteamService.LogoutAsync();

    public void Dispose() => SteamService.AuthStateChanged -= OnAuthStateChanged;
}
