@page "/about"
@attribute [Authorize]
@using System.Reflection
@using System.Runtime.InteropServices

<PageTitle>About · CASTER</PageTitle>

<PageHeader Title="About">
    <Actions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.BugReport" Href="@_issueUrl" Target="_blank">
            Report a bug
        </MudButton>
    </Actions>
</PageHeader>

<SectionCard>
    <div class="k-about">
        <img src="brand/logo-128.png" alt="" class="k-about-mark" draggable="false" />
        <div>
            <div class="k-about-name">CASTER <span class="k-status k-mono">@_version</span></div>
            <div class="k-muted">Arma 3 server management: install servers and mods from Steam, configure instances, and run and monitor them.</div>
            <div class="k-about-links">
                <a class="k-link" href="@RepoUrl" target="_blank" rel="noopener">Source code</a>
                <a class="k-link" href="@($"{RepoUrl}/blob/caster/CHANGELOG.md")" target="_blank" rel="noopener">Changelog</a>
                <a class="k-link" href="@($"{RepoUrl}/blob/caster/CONTRIBUTING.md")" target="_blank" rel="noopener">Contributing</a>
                <a class="k-link" href="@($"{RepoUrl}/blob/caster/LICENSE.md")" target="_blank" rel="noopener">License (GPL-3.0)</a>
            </div>
        </div>
    </div>
</SectionCard>

<div class="k-grid-2 mt-4">
    <SectionCard Title="System">
        <KeyValueList Items="_sysInfo.Select(i => (i.Label, (string?)i.Value))" Mono="true" />
    </SectionCard>
    <SectionCard Title="Built with">
        <ul class="k-about-stack">
            @foreach (var (tech, url) in _stack)
            {
                <li><a class="k-link" href="@url" target="_blank" rel="noopener">@tech</a></li>
            }
        </ul>
    </SectionCard>
</div>

@code {
    private const string RepoUrl = "https://github.com/bluefield-creator/KAST";

    private static readonly string _version =
        Assembly.GetEntryAssembly()
            ?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()
            ?.InformationalVersion ?? "dev";

    private static readonly string _runtime  = RuntimeInformation.FrameworkDescription;
    private static readonly string _platform = RuntimeInformation.OSDescription;
    private static readonly string _arch     = RuntimeInformation.ProcessArchitecture.ToString();
    private static readonly string _deploy   =
        Environment.GetEnvironmentVariable("DOTNET_RUNNING_IN_CONTAINER") == "true"
            ? "Docker" : "Native (.NET)";

    private static readonly (string Label, string Value)[] _sysInfo =
    [
        ("Version",    _version),
        ("Runtime",    _runtime),
        ("Platform",   _platform),
        ("Arch",       _arch),
        ("Deployment", _deploy),
    ];

    private static readonly (string Tech, string Url)[] _stack =
    [
        (".NET 10 + ASP.NET Core",  "https://dotnet.microsoft.com/"),
        ("Blazor Server",           "https://learn.microsoft.com/aspnet/core/blazor/"),
        ("MudBlazor",               "https://mudblazor.com/"),
        ("SteamKit2",               "https://github.com/SteamRE/SteamKit"),
        ("Entity Framework Core",   "https://learn.microsoft.com/ef/core/"),
        ("SignalR",                 "https://learn.microsoft.com/aspnet/core/signalr/"),
        ("OpenTelemetry",           "https://opentelemetry.io/"),
        ("SQLite",                  "https://sqlite.org/"),
    ];

    // Prefills a GitHub bug report with current session's system information.
    private static readonly string _issueUrl = BuildIssueUrl();

    private static string BuildIssueUrl()
    {
        var body =
            $"**CASTER Version:** `{_version}`\n" +
            $"**Runtime:** `{_runtime}`\n" +
            $"**Platform:** `{_platform}`\n" +
            $"**Arch:** `{_arch}`\n" +
            $"**Deployment:** `{_deploy}`\n\n" +
            "---\n\n" +
            "**Describe the bug**\n<!-- A clear and concise description of what the bug is. -->\n\n" +
            "**Steps to reproduce**\n1. \n2. \n3. \n\n" +
            "**Expected behaviour**\n<!-- What should have happened -->\n\n" +
            "**Actual behaviour**\n<!-- What happened instead -->\n\n" +
            "**Logs**\n```\n<!-- Paste relevant lines from the application log (status bar, Logs) -->\n```\n";

        return "https://github.com/bluefield-creator/KAST/issues/new" +
               "?labels=bug%2Cneeds-triage" +
               "&title=%5BBug%5D%3A+" +
               "&body=" + Uri.EscapeDataString(body);
    }
}
