@page "/Error"
@using System.Diagnostics

<PageTitle>Error · CASTER</PageTitle>

<SectionCard>
    <EmptyState Icon="@Icons.Material.Outlined.ErrorOutline" Title="Something went wrong"
                Description="An error occurred while processing your request. The details are in the application log.">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="">Go to the dashboard</MudButton>
    </EmptyState>
    @if (ShowRequestId)
    {
        <p class="k-muted k-error-id">Request ID: <code>@RequestId</code></p>
    }
</SectionCard>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
