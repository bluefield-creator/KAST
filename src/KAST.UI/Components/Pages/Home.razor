@page "/"
@attribute [Authorize]
@using KAST.Infrastructure.Services.Content
@implements IAsyncDisposable
@inject IModService ModService
@inject IServerInstanceService ServerService
@inject MonitoringStateService MonitoringState
@inject IAppEventBroadcaster Broadcaster
@inject NavigationManager Nav
@inject ContentProgressTracker ContentProgress
@inject ISteamService SteamService
@inject ILogger<Home> Logger

<PageTitle>Dashboard · CASTER</PageTitle>

<PageHeader Title="Dashboard" Subtitle="Servers, players and host health at a glance." />

@if (_isLoading)
{
    <div class="k-grid-4">
        @for (var i = 0; i < 4; i++)
        {
            <MudSkeleton Height="92px" SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" />
        }
    </div>
    <MudSkeleton Height="260px" SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" Class="mt-4" />
}
else
{
    @if (_instances.Count == 0)
    {
        var steamOk = SteamService.IsAuthenticated;
        var modsOk = _mods.Count > 0;
        <SectionCard Title="Getting started" Description="Four steps to your first running Arma 3 server." Class="mb-4">
            <ol class="k-steps">
                <li class="@(steamOk ? "done" : "current")">
                    <span class="k-step-marker">@(steamOk ? "✓" : "1")</span>
                    <div class="k-step-body">
                        <div class="k-step-title">Connect your Steam account</div>
                        <div class="k-step-text">
                            @(steamOk ? $"Signed in as {SteamService.Profile?.PersonaName ?? SteamService.CurrentUsername}." : "Required to download the Arma 3 server files and Workshop mods.")
                        </div>
                    </div>
                    @if (!steamOk)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="settings/steam">Sign in</MudButton>
                    }
                </li>
                <li class="@(modsOk ? "done" : steamOk ? "current" : null)">
                    <span class="k-step-marker">@(modsOk ? "✓" : "2")</span>
                    <div class="k-step-body">
                        <div class="k-step-title">Add mods</div>
                        <div class="k-step-text">
                            @(modsOk ? $"{_mods.Count} mod{(_mods.Count == 1 ? "" : "s")} in the library." : "Subscribe to Workshop items, import a launcher preset or add local mod folders. Optional.")
                        </div>
                    </div>
                    @if (!modsOk)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="mods" Disabled="!steamOk">Open mods</MudButton>
                    }
                </li>
                <li class="current">
                    <span class="k-step-marker">3</span>
                    <div class="k-step-body">
                        <div class="k-step-title">Create a server</div>
                        <div class="k-step-text">Name, port, game settings, difficulty and mods.</div>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="servers/new">New server</MudButton>
                </li>
                <li>
                    <span class="k-step-marker">4</span>
                    <div class="k-step-body">
                        <div class="k-step-title">Install and start</div>
                        <div class="k-step-text">Install the server files from the server's Installation tab, then press Start.</div>
                    </div>
                </li>
            </ol>
        </SectionCard>
    }

    <div class="k-grid-4">
        <MetricTile Label="Servers" Value="@_instances.Count.ToString()" Detail="@($"{_instances.Count(i => i.Status == ServerInstanceStatus.Running)} running")" Href="servers" />
        <MetricTile Label="Players online" Value="@GetPlayersOnline()" Detail="Across all running servers" />
        <MetricTile Label="Mods" Value="@_mods.Count.ToString()" Detail="In the library" Href="mods" />
        <MetricTile Label="Mod updates" Value="@_mods.Count(m => m.Status == ModStatus.UpdateAvailable).ToString()"
                    Tone="@(_mods.Any(m => m.Status == ModStatus.UpdateAvailable) ? "warn" : null)" Detail="Waiting to be applied" Href="mods" />
    </div>

    <div class="k-dash mt-4">
        <SectionCard Title="Servers" Flush="true">
            <Actions>
                <MudButton Variant="Variant.Text" Size="Size.Small" Href="servers">View all</MudButton>
            </Actions>
            <ChildContent>
                @if (_instances.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.Dns" Title="No servers yet" Description="Create one to see it here." />
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="k-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Status</th>
                                <th class="k-num-col">Players</th>
                                <th class="k-num-col">Port</th>
                                <th>Uptime</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var instance in _instances)
                            {
                                var id = instance.Id;
                                <tr class="k-row-link" @onclick="@(() => GoToServer(id))">
                                    <td class="k-cell-title">@instance.Name</td>
                                    <td><StatusBadge Status="instance.Status" /></td>
                                    <td class="k-num-col">@GetPlayers(instance)</td>
                                    <td class="k-num-col k-mono">@instance.Port</td>
                                    <td class="k-cell-muted">@(instance.Status == ServerInstanceStatus.Running ? UiHelpers.FormatUptime(instance.StartedAt) : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </ChildContent>
        </SectionCard>

        <SectionCard Title="Host">
            <div class="k-stack">
                <MetricTile Label="CPU" Value="@($"{MonitoringState.HostMetrics.CpuUsagePercent:F1}%")" Percent="MonitoringState.HostMetrics.CpuUsagePercent" />
                <MetricTile Label="Memory" Value="@($"{MonitoringState.HostMetrics.MemoryUsagePercent:F1}%")"
                            Detail="@($"{UiHelpers.FormatBytes(MonitoringState.HostMetrics.UsedMemoryBytes)} of {UiHelpers.FormatBytes(MonitoringState.HostMetrics.TotalMemoryBytes)}")"
                            Percent="MonitoringState.HostMetrics.MemoryUsagePercent" />
                <MetricTile Label="Disk" Value="@($"{MonitoringState.HostMetrics.DiskUsagePercent:F1}%")"
                            Detail="@($"{UiHelpers.FormatBytes(MonitoringState.HostMetrics.UsedDiskBytes)} of {UiHelpers.FormatBytes(MonitoringState.HostMetrics.TotalDiskBytes)}")"
                            Percent="MonitoringState.HostMetrics.DiskUsagePercent" />
            </div>
        </SectionCard>
    </div>

    <SectionCard Title="Recent activity" Class="mt-4" Flush="true">
        @if (_recentActivities.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.History" Title="No activity yet"
                        Description="Server starts, stops and mod changes show up here while this page is open." />
        }
        else
        {
            <ul class="k-activity">
                @foreach (var item in _recentActivities)
                {
                    <li>
                        <MudIcon Icon="@item.Icon" Color="@item.IconColor" Size="Size.Small" />
                        <span class="k-activity-text">@item.Message</span>
                        <time title="@item.Timestamp.ToLocalTime().ToString("g")">@UiHelpers.FormatRelativeTime(item.Timestamp)</time>
                    </li>
                }
            </ul>
        }
    </SectionCard>
}

@code {
    private IReadOnlyList<SteamMod> _mods = [];
    private IReadOnlyList<ServerInstance> _instances = [];
    private CancellationTokenSource? _cts;
    private bool _disposed;
    private bool _isLoading = true;

    private readonly record struct ActivityEvent(string Icon, Color IconColor, string Message, DateTime Timestamp);

    private readonly List<ActivityEvent> _recentActivities = [];
    private const int MaxRecentActivities = 10;

    private void GoToServer(int id) => Nav.NavigateTo("/servers/" + id);

    private string GetPlayersOnline()
    {
        var metrics = MonitoringState.InstanceMetrics.Values;
        var players = metrics.Sum(m => m.PlayerCount);
        var maxPlayers = metrics.Sum(m => m.MaxPlayers);
        return maxPlayers > 0 ? $"{players} / {maxPlayers}" : players.ToString();
    }

    private string GetPlayers(ServerInstance instance)
    {
        if (instance.Status != ServerInstanceStatus.Running
            || !MonitoringState.InstanceMetrics.TryGetValue(instance.Id, out var m))
            return "—";
        return m.MaxPlayers > 0 ? $"{m.PlayerCount}/{m.MaxPlayers}" : m.PlayerCount.ToString();
    }

    protected override void OnInitialized()
    {
        MonitoringState.EnsureStarted();
        MonitoringState.OnDataChanged += HandleDataChanged;

        Broadcaster.OnModStatusChanged += HandleModStatusChanged;
        Broadcaster.OnServerStatusChanged += HandleServerStatusChanged;
    }

    private void HandleDataChanged() => InvokeAsync(StateHasChanged);

    // Broadcaster events arrive on background threads: marshal onto the circuit
    // before touching component state.
    private void HandleModStatusChanged(ModStatusChangedEvent e) => _ = InvokeAsync(() => OnModStatusChanged(e));

    private void HandleServerStatusChanged(ServerStatusChangedEvent e) => _ = InvokeAsync(async () =>
    {
        OnServerStatusChanged(e);
        await RefreshData(); // keep the servers table in step with the change
        StateHasChanged();
    });

    private void OnModStatusChanged(ModStatusChangedEvent e)
    {
        var mod = _mods.FirstOrDefault(m => m.Id == e.ModId);
        var name = mod?.Name ?? $"Mod #{e.ModId}";
        var (icon, color, verb) = e.NewStatus switch
        {
            ModStatus.Installed => (Icons.Material.Outlined.CloudDownload, Color.Info, "installed"),
            ModStatus.Updating => (Icons.Material.Outlined.SystemUpdateAlt, Color.Warning, "updating"),
            ModStatus.Downloading => (Icons.Material.Outlined.CloudDownload, Color.Info, "downloading"),
            ModStatus.UpdateAvailable => (Icons.Material.Outlined.SystemUpdateAlt, Color.Warning, "has update available"),
            ModStatus.Error => (Icons.Material.Outlined.Error, Color.Error, "encountered an error"),
            _ => (Icons.Material.Outlined.Info, Color.Default, e.NewStatus.ToString().ToLowerInvariant())
        };
        AddActivityEvent(icon, color, $"Mod {name} {verb}");
        StateHasChanged();
    }

    private void OnServerStatusChanged(ServerStatusChangedEvent e)
    {
        var instance = _instances.FirstOrDefault(i => i.Id == e.ServerInstanceId);
        var name = instance?.Name ?? $"Server #{e.ServerInstanceId}";
        var (icon, color, verb) = e.NewStatus switch
        {
            ServerInstanceStatus.Running => (Icons.Material.Outlined.PlayCircle, Color.Success, "started"),
            ServerInstanceStatus.Crashed => (Icons.Material.Outlined.Error, Color.Error, "crashed"),
            ServerInstanceStatus.Stopped => (Icons.Material.Outlined.StopCircle, Color.Default, "stopped"),
            ServerInstanceStatus.Starting => (Icons.Material.Outlined.PlayArrow, Color.Warning, "starting"),
            ServerInstanceStatus.Stopping => (Icons.Material.Outlined.StopCircle, Color.Warning, "stopping"),
            ServerInstanceStatus.Restarting => (Icons.Material.Outlined.Refresh, Color.Warning, "restarting"),
            ServerInstanceStatus.Downloading => (Icons.Material.Outlined.CloudDownload, Color.Info, "downloading"),
            _ => (Icons.Material.Outlined.Info, Color.Default, e.NewStatus.ToString().ToLowerInvariant())
        };
        AddActivityEvent(icon, color, $"Server {name} {verb}");
    }

    private void AddActivityEvent(string icon, Color iconColor, string message, DateTime? timestamp = null)
    {
        _recentActivities.Insert(0, new ActivityEvent(icon, iconColor, message, timestamp ?? DateTime.UtcNow));
        while (_recentActivities.Count > MaxRecentActivities)
            _recentActivities.RemoveAt(_recentActivities.Count - 1);
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
        _cts = new CancellationTokenSource();
        _ = RunPeriodicRefresh(_cts.Token);
    }

    private async Task RefreshData(CancellationToken ct = default)
    {
        if (_disposed || ct.IsCancellationRequested) return;
        try
        {
            _mods = await ModService.GetAllModsAsync(ct);
            _instances = await ServerService.GetAllInstancesAsync(ct);
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh dashboard data");
        }
        finally
        {
            if (!ct.IsCancellationRequested)
                _isLoading = false;
        }
    }

    private async Task RunPeriodicRefresh(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (!_disposed && await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    await RefreshData(ct);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        MonitoringState.OnDataChanged -= HandleDataChanged;
        Broadcaster.OnModStatusChanged -= HandleModStatusChanged;
        Broadcaster.OnServerStatusChanged -= HandleServerStatusChanged;
        _cts?.Cancel();
        _cts?.Dispose();
        await Task.CompletedTask;
    }
}
