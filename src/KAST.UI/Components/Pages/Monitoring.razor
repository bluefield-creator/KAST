@page "/monitoring"
@attribute [Authorize]
@implements IAsyncDisposable
@inject MonitoringStateService State
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IProcessManagerService ProcessManager
@inject ThemeService ThemeService
@inject IDialogService Dialogs
@inject ILogger<Monitoring> Logger

<PageTitle>Monitoring · CASTER</PageTitle>

<PageHeader Title="Monitoring" Subtitle="Host resources, server metrics and every Arma process on this machine." />

<div class="k-grid-3">
    <MetricTile Label="CPU" Value="@($"{State.HostMetrics.CpuUsagePercent:F1}%")" Percent="State.HostMetrics.CpuUsagePercent" />
    <MetricTile Label="Memory" Value="@($"{State.HostMetrics.MemoryUsagePercent:F1}%")" Percent="State.HostMetrics.MemoryUsagePercent"
                Detail="@($"{UiHelpers.FormatBytes(State.HostMetrics.UsedMemoryBytes)} of {UiHelpers.FormatBytes(State.HostMetrics.TotalMemoryBytes)}")" />
    <MetricTile Label="Disk" Value="@($"{State.HostMetrics.DiskUsagePercent:F1}%")" Percent="State.HostMetrics.DiskUsagePercent"
                Detail="@($"{UiHelpers.FormatBytes(State.HostMetrics.UsedDiskBytes)} of {UiHelpers.FormatBytes(State.HostMetrics.TotalDiskBytes)}")" />
</div>

<div class="k-grid-2 mt-4">
    <SectionCard Title="Host CPU">
        <div class="k-chart"><canvas id="chart-host-cpu"></canvas></div>
    </SectionCard>
    <SectionCard Title="Host memory">
        <div class="k-chart"><canvas id="chart-host-mem"></canvas></div>
    </SectionCard>
</div>

<SectionCard Title="Arma processes" Description="All arma3server processes on this host, including ones CASTER does not manage." Class="mt-4" Flush="true">
    @if (_extProcesses.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Memory" Title="No Arma processes running" />
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="k-table">
            <thead>
                <tr>
                    <th class="k-num-col">PID</th>
                    <th>Process</th>
                    <th>Owner</th>
                    <th class="k-num-col">Port</th>
                    <th class="k-num-col">CPU</th>
                    <th class="k-num-col">Memory</th>
                    <th>Uptime</th>
                    <th class="k-actions-col"><span class="k-sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var process in _extProcesses)
                {
                    var p = process;
                    <tr>
                        <td class="k-num-col k-mono">@p.Pid</td>
                        <td class="k-mono">@p.ProcessName</td>
                        <td>
                            @if (p.IsManaged)
                            {
                                <a class="k-link" href="@($"servers/{p.LinkedInstanceId}")">@p.LinkedInstanceName</a>
                            }
                            else
                            {
                                <span class="k-status k-status-warn" title="Not managed by CASTER">External</span>
                            }
                        </td>
                        <td class="k-num-col k-mono">@(p.Port?.ToString() ?? "—")</td>
                        <td class="k-num-col">@p.CpuPercent.ToString("F1")%</td>
                        <td class="k-num-col">@UiHelpers.FormatBytes(p.MemoryBytes)</td>
                        <td class="k-cell-muted">@FormatUptime(p.StartTime)</td>
                        <td class="k-actions-col">
                            @if (!p.IsManaged)
                            {
                                <MudTooltip Text="Kill process">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Dangerous" Size="Size.Small" Color="Color.Error"
                                                   aria-label="@($"Kill process {p.Pid}")"
                                                   OnClick="@(() => KillExternalProcess(p))" Disabled="_killingPids.Contains(p.Pid)" />
                                </MudTooltip>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</SectionCard>

@if (State.Instances.Count == 0)
{
    <SectionCard Title="Servers" Class="mt-4">
        <EmptyState Icon="@Icons.Material.Outlined.Insights" Title="No running servers" Description="Per-server charts appear here while servers are running." />
    </SectionCard>
}
else
{
    @foreach (var instance in State.Instances)
    {
        var metrics = State.InstanceMetrics.GetValueOrDefault(instance.Id);
        <SectionCard Title="@instance.Name" Class="mt-4">
            <Actions>
                <StatusBadge Status="instance.Status" />
                @if (metrics != null)
                {
                    <span class="k-status">@metrics.PlayerCount@(metrics.MaxPlayers > 0 ? $" / {metrics.MaxPlayers}" : "") players</span>
                }
                <MudButton Variant="Variant.Text" Size="Size.Small" Href="@($"servers/{instance.Id}")">Open</MudButton>
            </Actions>
            <ChildContent>
                <div class="k-grid-3">
                    <div>
                        <div class="k-chart-title">CPU</div>
                        <div class="k-chart k-chart-sm"><canvas id="chart-inst-@(instance.Id)-cpu"></canvas></div>
                    </div>
                    <div>
                        <div class="k-chart-title">Memory</div>
                        <div class="k-chart k-chart-sm"><canvas id="chart-inst-@(instance.Id)-mem"></canvas></div>
                    </div>
                    <div>
                        <div class="k-chart-title">Players</div>
                        <div class="k-chart k-chart-sm"><canvas id="chart-inst-@(instance.Id)-players"></canvas></div>
                    </div>
                </div>
            </ChildContent>
        </SectionCard>
    }
}

@code {
    private bool _chartsInitialized;
    private volatile bool _disposed;
    private readonly List<RunningProcessInfo> _extProcesses = [];
    private readonly HashSet<int> _killingPids = [];

    protected override void OnInitialized()
    {
        State.EnsureStarted();
        State.OnDataChanged += HandleDataChanged;
        ThemeService.OnChange += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        // Chart axis chrome is baked in at creation time — rebuild on theme flips
        if (_chartsInitialized)
            Observe(InvokeAsync(InitChartsAsync), "rebuild charts");
    }

    // Fire-and-forget work from event handlers must be observed: a faulted
    // task here (JS interop failing after the circuit went away, a disposed
    // renderer) otherwise surfaces later as an UnobservedTaskException.
    private void Observe(Task task, string what)
    {
        _ = task.ContinueWith(
            t => Logger.LogDebug(t.Exception, "Monitoring page failed to {What}", what),
            CancellationToken.None,
            TaskContinuationOptions.OnlyOnFaulted | TaskContinuationOptions.ExecuteSynchronously,
            TaskScheduler.Default);
    }

    private void HandleDataChanged()
    {
        // State.OnDataChanged fires from a background snapshot thread — marshal
        // all collection mutation to the circuit thread.
        if (_disposed) return;
        Observe(InvokeAsync(async () =>
        {
            if (_disposed) return;
            _extProcesses.Clear();
            _extProcesses.AddRange(State.ExternalProcesses);
            StateHasChanged();
            if (_chartsInitialized) await UpdateChartsAsync();
        }), "refresh");
    }

    private async Task KillExternalProcess(RunningProcessInfo process)
    {
        if (process.IsManaged) return;

        if (!await Dialogs.ConfirmAsync("Kill process",
                $"Force-kill {process.ProcessName} (PID {process.Pid})? It is not managed by CASTER and will not save anything.",
                "Kill", destructive: true))
            return;

        _killingPids.Add(process.Pid);
        try
        {
            var killed = await ProcessManager.KillProcessAsync(process.Pid);
            if (killed)
                Snackbar.Add($"Killed PID {process.Pid}", Severity.Success);
            else
                Snackbar.Add($"Failed to kill PID {process.Pid}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _killingPids.Remove(process.Pid);
        }
    }

    private static string FormatUptime(DateTime startTime)
    {
        var span = DateTime.UtcNow - startTime.ToUniversalTime();
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m";
        return $"{(int)span.TotalMinutes}m {span.Seconds}s";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitChartsAsync();
            _chartsInitialized = true;
        }
    }

    private async Task InitChartsAsync()
    {
        await CreateLineChart("chart-host-cpu", "CPU %", "var(--k-info)", 100);
        await CreateLineChart("chart-host-mem", "Memory %", "var(--k-success)", 100);
        foreach (var id in State.Instances.Select(i => i.Id))
        {
            await CreateLineChart($"chart-inst-{id}-cpu", "CPU %", "var(--k-info)", 100);
            await CreateLineChart($"chart-inst-{id}-mem", "Memory (MB)", "var(--k-success)", null);
            await CreateLineChart($"chart-inst-{id}-players", "Players", "var(--k-primary)", null);
        }
        await UpdateChartsAsync();
    }

    private async Task CreateLineChart(string canvasId, string label, string color, int? maxY)
    {
        // Axis chrome resolves from the theme tokens at creation time;
        // charts are rebuilt when the colour mode changes.
        var tickColor = "var(--k-muted-foreground)";
        var gridColor = "var(--k-border)";

        var config = new
        {
            type = "line",
            data = new { labels = Array.Empty<string>(), datasets = new[] { new { label, data = Array.Empty<double>(), borderColor = color, backgroundColor = color + "1A", borderWidth = 1.5, pointRadius = 0, fill = true, tension = 0.3 } } },
            options = new
            {
                responsive = true, maintainAspectRatio = false, animation = false,
                interaction = new { intersect = false, mode = "index" },
                plugins = new { legend = new { display = false }, tooltip = new { enabled = true } },
                scales = new
                {
                    x = new { ticks = new { maxTicksLimit = 12, color = tickColor, font = new { size = 10 } }, grid = new { color = gridColor } },
                    y = new { min = 0, max = maxY, ticks = new { color = tickColor, font = new { size = 10 } }, grid = new { color = gridColor } }
                }
            }
        };
        await JS.InvokeVoidAsync("kastCharts.create", canvasId, config);
    }

    private async Task UpdateChartsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("kastCharts.update", "chart-host-cpu", State.HostLabels, new[] { State.HostCpu });
            await JS.InvokeVoidAsync("kastCharts.update", "chart-host-mem", State.HostLabels, new[] { State.HostMem });
            foreach (var id in State.Instances.Select(i => i.Id))
            {
                if (State.InstanceHistory.TryGetValue(id, out var hist))
                {
                    await JS.InvokeVoidAsync("kastCharts.update", $"chart-inst-{id}-cpu", State.HostLabels, new[] { hist.Cpu });
                    await JS.InvokeVoidAsync("kastCharts.update", $"chart-inst-{id}-mem", State.HostLabels, new[] { hist.Mem });
                    await JS.InvokeVoidAsync("kastCharts.update", $"chart-inst-{id}-players", State.HostLabels, new[] { hist.Players });
                }
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
        {
            // Circuit going away or chart not mounted yet — next tick retries.
        }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        State.OnDataChanged -= HandleDataChanged;
        ThemeService.OnChange -= HandleThemeChanged;
        return ValueTask.CompletedTask;
    }
}
