@page "/servers/new"
@page "/servers/{Id:int}"
@attribute [Authorize]
@using KAST.UI.Components.Pages.ServerEditTabs
@inject IServerConfigService ConfigService
@inject ISettingsService SettingsService
@inject IOutputSanitizer OutputSanitizer
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServerInstanceService ServerService
@inject IDialogService Dialogs
@implements IDisposable

<PageTitle>@(_isNew ? "New server" : _instance.Name) · CASTER</PageTitle>

<PageHeader Title="@(_isNew ? "New server" : _instance.Name)" Breadcrumbs="Crumbs">
    <TitleContent>
        @if (!_isNew)
        {
            <StatusBadge Status="_instance.Status" />
        }
        @if (HasUnsavedChanges)
        {
            <span class="k-status k-status-warn" title="Save to keep your changes">Unsaved changes</span>
        }
    </TitleContent>
    <Actions>
        @if (!_isNew && _instances.Count > 1)
        {
            <MudMenu Label="Switch server" EndIcon="@Icons.Material.Outlined.ExpandMore" Variant="Variant.Text" Dense="true"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var instance in _instances)
                {
                    var id = instance.Id;
                    <MudMenuItem OnClick="@(() => NavigateToInstance(id))">
                        <span class="k-dot @UiHelpers.GetStatusDotClass(instance.Status)"></span>&nbsp; @instance.Name
                    </MudMenuItem>
                }
            </MudMenu>
        }
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Save" OnClick="Save">
            @(_isNew ? "Create" : "Save")
        </MudButton>
        @if (!_isNew)
        {
            @if (_instance.Status is ServerInstanceStatus.Running)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.RestartAlt" OnClick="RestartServer">Restart</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Stop" OnClick="StopServer">Stop</MudButton>
            }
            else if (UiHelpers.IsTransitional(_instance.Status))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Stop" OnClick="StopServer"
                           Disabled="@(_instance.Status == ServerInstanceStatus.Downloading)">
                    Stop
                </MudButton>
            }
            else
            {
                <MudTooltip Text="@(_instance.InstalledAt.HasValue ? "Save and start the server" : "Install the server files first (Installation tab)")">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PlayArrow"
                               OnClick="LaunchServer" Disabled="@(!_instance.InstalledAt.HasValue)">
                        Start
                    </MudButton>
                </MudTooltip>
            }
        }
    </Actions>
    <ChildContent>
        @if (!_isNew)
        {
            <span>Port <span class="k-mono">@_instance.Port</span></span>
            @if (_instance.ProcessId is { } pid)
            {
                <span>PID <span class="k-mono">@pid</span></span>
            }
            @if (_instance.Status == ServerInstanceStatus.Running)
            {
                <span>Up <span class="k-num">@UiHelpers.FormatUptime(_instance.StartedAt)</span></span>
            }
            <span>@_instance.Mods.Count mod@(_instance.Mods.Count == 1 ? "" : "s")</span>
            @if (_instance.HeadlessClientCount > 0)
            {
                <span>@_instance.HeadlessClientCount headless client@(_instance.HeadlessClientCount == 1 ? "" : "s")</span>
            }
            <span>@(_instance.InstalledAt.HasValue ? $"Build {_instance.InstalledBuildId ?? "installed"}" : "Server files not installed")</span>
        }
    </ChildContent>
</PageHeader>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" ApplyEffectsToContainer="true" PanelClass="pt-4" Class="k-tabs">

    <MudTabPanel Text="Overview" Disabled="_isNew">
        @if (!_isNew)
        {
            <MonitorTab Instance="_instance" OnStatusChanged="StateHasChanged" />
        }
    </MudTabPanel>

    <MudTabPanel Text="General">
        <GeneralTab Instance="_instance"
                    ServerConfig="_serverConfig"
                    IsNew="_isNew"
                    OnNameChanged="OnNameChanged"
                    OnServerConfigChanged="OnServerConfigChanged" />
    </MudTabPanel>

    <MudTabPanel Text="server.cfg">
        <ServerConfigTab Config="_serverConfig"
                         Instance="_instance"
                         MissionDownloadBaseUrl="_missionDownloadBaseUrl"
                         MissionCount="_missionCount"
                         RawContent="@_serverCfgRaw"
                         OnConfigChanged="OnServerConfigChanged"
                         OnRawContentChanged="OnServerCfgRawChanged" />
    </MudTabPanel>

    <MudTabPanel Text="basic.cfg">
        <BasicConfigTab Config="_basicConfig"
                        RawContent="@_basicCfgRaw"
                        OnConfigChanged="OnBasicConfigChanged"
                        OnRawContentChanged="OnBasicCfgRawChanged" />
    </MudTabPanel>

    <MudTabPanel Text="Difficulty">
        <DifficultyTab Profile="_profileData"
                       RawContent="@_profileRaw"
                       OnProfileChanged="OnProfileChanged"
                       OnRawContentChanged="OnProfileRawChanged" />
    </MudTabPanel>

    <MudTabPanel Text="@($"Mods ({_instance.Mods.Count})")">
        <ModsTab Instance="_instance" IsNew="_isNew" />
    </MudTabPanel>

    <MudTabPanel Text="Missions">
        <MissionsTab Instance="_instance" />
    </MudTabPanel>

    <MudTabPanel Text="Installation"
                 BadgeData="@(!_instance.InstalledAt.HasValue && !_isNew ? "!" : null)"
                 BadgeColor="Color.Warning">
        <InstallTab Instance="_instance"
                    IsNew="_isNew"
                    OnInstallComplete="HandleInstallComplete" />
    </MudTabPanel>

</MudTabs>

@code {
    [Parameter] public int? Id { get; set; }

    private ServerInstance _instance = new();
    private bool _isNew => Id == null || Id == 0;
    private int _activeTab;
    private string _serversDirectory = "./servers";
    private const int OverviewTabIndex = 0;
    private const int GeneralTabIndex = 1;
    private IReadOnlyList<ServerInstance> _instances = [];

    private IReadOnlyList<(string, string)> Crumbs => [("Servers", "servers")];
    private int? _loadedId;
    private bool _hasLoadedParameters;

    private ServerConfigData _serverConfig = new();
    private BasicConfigData _basicConfig = new();
    private Arma3ProfileData _profileData = new();
    private string _serverCfgRaw = "";
    private string _basicCfgRaw = "";
    private string _profileRaw = "";
    private string? _missionDownloadBaseUrl;
    private int _missionCount;

    private bool _isDirty;
    private string _cleanSnapshot = "";
    private IDisposable? _locationChangingRegistration;

    // Many editor fields bind straight to _instance without an explicit change
    // callback (ports, DLC switches, schedule…), so the explicit _isDirty flag
    // alone misses them. A field snapshot taken at load/save time catches every
    // scalar edit.
    private bool HasUnsavedChanges => _isDirty || ComputeSnapshot() != _cleanSnapshot;

    private string ComputeSnapshot()
    {
        var instanceFields = string.Join("|", typeof(ServerInstance).GetProperties()
            .Where(p => p.CanWrite &&
                        (p.PropertyType.IsPrimitive || p.PropertyType.IsEnum ||
                         p.PropertyType == typeof(string) ||
                         Nullable.GetUnderlyingType(p.PropertyType) is not null))
            .Where(p => p.Name is not ("Status" or "ProcessId" or "StartedAt" or "CreatedAt"
                        or "LastModified" or "InstalledAt" or "InstalledBuildId"
                        or "ServerCfgContent" or "BasicCfgContent" or "ArmaProfileContent"))
            .OrderBy(p => p.Name)
            .Select(p => $"{p.Name}={p.GetValue(_instance)}"));

        return $"{instanceFields}\n{_serverCfgRaw}\n{_basicCfgRaw}\n{_profileRaw}";
    }

    protected override Task OnInitializedAsync()
    {
        _locationChangingRegistration = Nav.RegisterLocationChangingHandler(OnLocationChanging);
        _ = WatchDirtyStateAsync(_dirtyWatchCts.Token);
        return Task.CompletedTask;
    }

    // Child tabs bind straight to _instance, which never re-renders this parent —
    // poll the snapshot and repaint only when the unsaved-state flips.
    private readonly CancellationTokenSource _dirtyWatchCts = new();
    private bool _lastDirtyShown;

    private async Task WatchDirtyStateAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(ct))
            {
                var dirty = HasUnsavedChanges;
                if (dirty != _lastDirtyShown)
                {
                    _lastDirtyShown = dirty;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_hasLoadedParameters && _loadedId == Id)
            return;

        _hasLoadedParameters = true;
        _loadedId = Id;
        _instances = await WithServerServiceAsync(s => s.GetAllInstancesAsync());
        ResetEditorState();

        if (!_isNew)
        {
            var instance = await WithServerServiceAsync(s => s.GetInstanceByIdAsync(Id!.Value));
            if (instance == null) { Nav.NavigateTo("/servers"); return; }
            _instance = instance;

            if (!string.IsNullOrEmpty(_instance.ServerCfgContent))
            { _serverConfig = ConfigService.ParseServerConfig(_instance.ServerCfgContent); _serverCfgRaw = _instance.ServerCfgContent; }
            if (!string.IsNullOrEmpty(_instance.BasicCfgContent))
            { _basicConfig = ConfigService.ParseBasicConfig(_instance.BasicCfgContent); _basicCfgRaw = _instance.BasicCfgContent; }
            if (!string.IsNullOrEmpty(_instance.ArmaProfileContent))
            { _profileData = ConfigService.ParseArma3Profile(_instance.ArmaProfileContent); _profileRaw = _instance.ArmaProfileContent; }

            _missionDownloadBaseUrl = (await SettingsService.GetSettingsAsync()).MissionDownloadBaseUrl;
        }
        else
        {
            var settings = await SettingsService.GetSettingsAsync();
            _serversDirectory = settings.ServersDirectory;
            _instance.Name = $"Server-{DateTime.UtcNow:yyyyMMdd-HHmmss}";
            _instance.InstallPath = BuildInstallPath(_serversDirectory, _instance.Name);
            _serverConfig.Hostname = _instance.Name;
        }

        if (string.IsNullOrEmpty(_serverCfgRaw)) _serverCfgRaw = ConfigService.SerializeServerConfig(_serverConfig);
        if (string.IsNullOrEmpty(_basicCfgRaw)) _basicCfgRaw = ConfigService.SerializeBasicConfig(_basicConfig);
        if (string.IsNullOrEmpty(_profileRaw)) _profileRaw = ConfigService.SerializeArma3Profile(_profileData);

        _isDirty = false;
        _cleanSnapshot = ComputeSnapshot();
    }

    private void ResetEditorState()
    {
        _activeTab = _isNew ? GeneralTabIndex : OverviewTabIndex;
        _instance = new ServerInstance();
        _serverConfig = new ServerConfigData();
        _basicConfig = new BasicConfigData();
        _profileData = new Arma3ProfileData();
        _serverCfgRaw = "";
        _basicCfgRaw = "";
        _profileRaw = "";
    }

    private void OnNameChanged()
    {
        if (_isNew && !string.IsNullOrWhiteSpace(_instance.Name))
            _instance.InstallPath = BuildInstallPath(_serversDirectory, _instance.Name);
        _isDirty = true;
    }

    private static string BuildInstallPath(string serversDirectory, string serverName)
    {
        var safeName = serverName.Trim();
        foreach (var invalidChar in Path.GetInvalidFileNameChars())
            safeName = safeName.Replace(invalidChar, '_');
        safeName = safeName
            .Replace(Path.DirectorySeparatorChar, '_')
            .Replace(Path.AltDirectorySeparatorChar, '_');

        return Path.Join(serversDirectory, string.IsNullOrWhiteSpace(safeName) ? "Server" : safeName);
    }

    private void OnServerConfigChanged() { _serverCfgRaw = ConfigService.SerializeServerConfig(_serverConfig); _isDirty = true; }
    private void OnServerCfgRawChanged(string v) { _serverCfgRaw = v; _serverConfig = ConfigService.ParseServerConfig(v); _isDirty = true; }
    private void OnBasicConfigChanged() { _basicCfgRaw = ConfigService.SerializeBasicConfig(_basicConfig); _isDirty = true; }
    private void OnBasicCfgRawChanged(string v) { _basicCfgRaw = v; _basicConfig = ConfigService.ParseBasicConfig(v); _isDirty = true; }
    private void OnProfileChanged() { _profileRaw = ConfigService.SerializeArma3Profile(_profileData); _isDirty = true; }
    private void OnProfileRawChanged(string v) { _profileRaw = v; _profileData = ConfigService.ParseArma3Profile(v); _isDirty = true; }

    private async Task HandleInstallComplete()
    {
        var fresh = await WithServerServiceAsync(s => s.GetInstanceByIdAsync(_instance.Id));
        if (fresh != null) _instance = fresh;
        StateHasChanged();
    }

    private async Task Save()
        => await SaveAsync();

    private async Task<bool> SaveAsync()
    {
        try
        {
            // Auto-inject missionHTTPDownloadBaseURL if HTTP downloads enabled and no custom URL set
            if (_instance.HttpDownloadsEnabled && string.IsNullOrEmpty(_serverConfig.MissionHTTPDownloadBaseURL))
            {
                _serverConfig.MissionHTTPDownloadBaseURL = !string.IsNullOrEmpty(_missionDownloadBaseUrl)
                    ? $"{_missionDownloadBaseUrl.TrimEnd('/')}/mission-download/{_instance.Id}/"
                    : $"http://localhost:{_instance.Port}/mission-download/{_instance.Id}/";
            }

            _instance.ServerCfgContent = ConfigService.SerializeServerConfig(_serverConfig);
            _instance.BasicCfgContent = ConfigService.SerializeBasicConfig(_basicConfig);
            _instance.ArmaProfileContent = ConfigService.SerializeArma3Profile(_profileData);

            var isRunning = await IsRuntimeActive();

            if (_isNew) await WithServerServiceAsync(s => s.CreateInstanceAsync(_instance));
            else await WithServerServiceAsync(s => s.UpdateInstanceAsync(_instance));

            if (!string.IsNullOrEmpty(_instance.InstallPath) && !isRunning)
            {
                await WithServerServiceAsync(async s =>
                {
                    await s.LinkModsAsync(_instance.Id);
                    s.WriteConfigFiles(_instance);
                    return true;
                });
            }

            Snackbar.Add(
                isRunning
                    ? "Server saved in CASTER. Stop or restart the server to apply config file changes."
                    : "Server saved",
                isRunning ? Severity.Warning : Severity.Success);
            _isDirty = false;
            _cleanSnapshot = ComputeSnapshot();

            if (Id == null || Id == 0) Nav.NavigateTo($"/servers/{_instance.Id}", replace: true);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save: {ex.Message}", Severity.Error);
            await RefreshCurrentInstance();
            return false;
        }
    }

    private async Task LaunchServer()
    {
        if (_isNew) return;
        try
        {
            if (!await SaveAsync())
                return;

            await WithServerServiceAsync(s => s.StartInstanceAsync(_instance.Id));
            _instance = (await WithServerServiceAsync(s => s.GetInstanceByIdAsync(_instance.Id)))!;
            _activeTab = OverviewTabIndex;
            StateHasChanged();
        }
        catch (Exception ex) { Snackbar.Add($"Failed to launch: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
    }

    private async Task RestartServer()
    {
        if (_isNew) return;
        if (!await Dialogs.ConfirmAsync("Restart server", $"Restart {_instance.Name}? Connected players are disconnected.", "Restart"))
            return;
        try
        {
            await WithServerServiceAsync(s => s.RestartInstanceAsync(_instance.Id));
            await RefreshCurrentInstance();
            Snackbar.Add("Server restarted", Severity.Success);
        }
        catch (Exception ex)
        {
            await RefreshCurrentInstance();
            Snackbar.Add($"Failed to restart: {OutputSanitizer.SanitizeException(ex)}", Severity.Error);
        }
    }

    private async Task StopServer()
    {
        if (_isNew) return;
        if (!await Dialogs.ConfirmAsync("Stop server", $"Stop {_instance.Name}? Connected players are disconnected.", "Stop", destructive: true))
            return;
        try
        {
            await WithServerServiceAsync(s => s.StopInstanceAsync(_instance.Id));
            await RefreshCurrentInstance();
            Snackbar.Add("Server stopped", Severity.Success);
        }
        catch (Exception ex)
        {
            await RefreshCurrentInstance();
            Snackbar.Add($"Failed to stop: {OutputSanitizer.SanitizeException(ex)}", Severity.Error);
        }
    }

    private async Task RefreshCurrentInstance()
    {
        if (_isNew || _instance.Id <= 0)
            return;

        var fresh = await WithServerServiceAsync(s => s.GetInstanceByIdAsync(_instance.Id));
        if (fresh != null)
            _instance = fresh;
    }

    private void NavigateToInstance(int id)
    {
        if (id != _instance.Id)
            Nav.NavigateTo($"/servers/{id}");
    }

    private async Task<bool> IsRuntimeActive()
    {
        if (_isNew)
            return false;

        var current = await WithServerServiceAsync(s => s.GetInstanceByIdAsync(_instance.Id));
        if (current is null)
            return _instance.Status is ServerInstanceStatus.Running
                or ServerInstanceStatus.Starting
                or ServerInstanceStatus.Restarting
                or ServerInstanceStatus.Stopping;

        _instance.Status = current.Status;
        _instance.ProcessId = current.ProcessId;
        _instance.StartedAt = current.StartedAt;

        return current.Status is ServerInstanceStatus.Running
            or ServerInstanceStatus.Starting
            or ServerInstanceStatus.Restarting
            or ServerInstanceStatus.Stopping;
    }

    private string GetCommandLinePreview()
    {
        _instance.ServerCfgContent = ConfigService.SerializeServerConfig(_serverConfig);
        _instance.BasicCfgContent = ConfigService.SerializeBasicConfig(_basicConfig);
        _instance.ArmaProfileContent = ConfigService.SerializeArma3Profile(_profileData);
        return WithServerService(s => s.GetCommandLine(_instance));
    }

    private Task<TResult> WithServerServiceAsync<TResult>(Func<IServerInstanceService, Task<TResult>> action)
        => action(ServerService);

    private Task WithServerServiceAsync(Func<IServerInstanceService, Task> action)
        => action(ServerService);

    private TResult WithServerService<TResult>(Func<IServerInstanceService, TResult> action)
        => action(ServerService);

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (!HasUnsavedChanges) return;

        context.PreventNavigation();

        var discard = await JS.InvokeAsync<bool>("confirm", "You have unsaved changes to this server instance. Discard them?");

        if (discard)
        {
            _isDirty = false;
            _cleanSnapshot = ComputeSnapshot();
            Nav.NavigateTo(context.TargetLocation, forceLoad: false);
        }
    }

    public void Dispose()
    {
        _locationChangingRegistration?.Dispose();
        _dirtyWatchCts.Cancel();
        _dirtyWatchCts.Dispose();
    }

}
