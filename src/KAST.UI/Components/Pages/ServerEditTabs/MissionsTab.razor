@using KAST.Core.Models
@using System.IO
@inject IMissionService MissionService
@inject IModPresetService ModPresetService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<div class="d-flex flex-column gap-3" style="height:100%;">

    @* ── Workspace header: view switcher + upload ── *@
    <div class="d-flex align-center gap-2 mt-2 flex-wrap">
        <MudButtonGroup OverrideStyles="false" Size="Size.Small">
            <MudButton Variant="@(_view == ViewLibrary ? Variant.Filled : Variant.Outlined)"
                       Color="@(_view == ViewLibrary ? Color.Primary : Color.Default)"
                       StartIcon="@Icons.Material.Filled.VideoLibrary"
                       OnClick="@(() => _view = ViewLibrary)">
                Library&nbsp;<MudText Typo="Typo.caption" Style="opacity:.75;">(@_missions.Count)</MudText>
            </MudButton>
            <MudButton Variant="@(_view == ViewCampaigns ? Variant.Filled : Variant.Outlined)"
                       Color="@(_view == ViewCampaigns ? Color.Tertiary : Color.Default)"
                       StartIcon="@Icons.Material.Filled.AutoStories"
                       OnClick="@(() => _view = ViewCampaigns)">
                Campaigns&nbsp;<MudText Typo="Typo.caption" Style="opacity:.75;">(@_campaigns.Count)</MudText>
            </MudButton>
            <MudButton Variant="@(_view == ViewCollections ? Variant.Filled : Variant.Outlined)"
                       Color="@(_view == ViewCollections ? Color.Secondary : Color.Default)"
                       StartIcon="@Icons.Material.Filled.Collections"
                       OnClick="@(() => _view = ViewCollections)">
                Collections&nbsp;<MudText Typo="Typo.caption" Style="opacity:.75;">(@_sets.Count)</MudText>
            </MudButton>
        </MudButtonGroup>
        <MudSpacer />
        @if (_view == ViewCampaigns)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Tertiary" Variant="Variant.Filled"
                       Size="Size.Small" OnClick="@(() => _showCampaignDialog = true)">
                New Campaign
            </MudButton>
        }
        else if (_view == ViewCollections)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Secondary" Variant="Variant.Filled"
                       Size="Size.Small" OnClick="@(() => _showSetDialog = true)">
                New Collection
            </MudButton>
        }
        <MudButton StartIcon="@Icons.Material.Filled.UploadFile"
                   Color="Color.Primary" Variant="Variant.Filled"
                   Size="Size.Small"
                   OnClick="OpenUploadDialog">
            Upload Mission
        </MudButton>
    </div>

    @* ════════════════════ LIBRARY VIEW ════════════════════ *@
    @if (_view == ViewLibrary)
    {
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudTextField T="string"
                          Value="_searchQuery"
                          ValueChanged="@((string value) => OnMissionSearchChanged(value))"
                          Placeholder="Search missions… (use #tag to filter)"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true" Immediate="true"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Style="max-width:320px;" />
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                @AvailableMaps.Count maps
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                @_missions.Count(m => m.TagAssignments.Count == 0) untagged
            </MudChip>
        </div>

        <div class="d-flex align-center gap-1 flex-wrap">
            <MudChip T="string" Size="Size.Small"
                     Variant="@(string.IsNullOrWhiteSpace(_activeMapFilter) ? Variant.Filled : Variant.Outlined)"
                     Color="Color.Default"
                     OnClick="@(() => SetMapFilter(null))">
                All maps (@_missions.Count)
            </MudChip>
            @foreach (var map in AvailableMaps.Take(12))
            {
                <MudChip T="string" Size="Size.Small"
                         Variant="@(_activeMapFilter == map ? Variant.Filled : Variant.Outlined)"
                         Color="@(_activeMapFilter == map ? Color.Primary : Color.Default)"
                         OnClick="@(() => SetMapFilter(map))">
                    @map (@CountMissionsOnMap(map))
                </MudChip>
            }
            @if (AvailableMaps.Count > 12)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">+@(AvailableMaps.Count - 12) more maps</MudText>
            }
        </div>

        <div class="mud-paper mud-elevation-1 pa-3" style="flex:1; min-height:0; overflow-y:auto;">
            @* Active tag filter chips *@
            @if (_activeFilterTags.Count > 0)
            {
                <div class="d-flex align-center gap-1 mb-2 flex-wrap">
                    @foreach (var tag in _activeFilterTags)
                    {
                        <MudChip T="MissionTag" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                 OnClose="() => RemoveFilterTag(tag)">
                            #@tag.Name
                        </MudChip>
                    }
                </div>
            }

            @if (_loadingMissions)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
            }
            else if (_filteredMissions.Count == 0)
            {
                <div class="d-flex flex-column align-center justify-center gap-2" style="padding:60px 0;">
                    <MudIcon Icon="@Icons.Material.Filled.FolderOff" Size="Size.Large" Color="Color.Default" />
                    <MudText Typo="Typo.body1" Color="Color.Default">@(HasMissionFilters ? "No missions match the filters" : "No missions yet")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">@(HasMissionFilters ? "Clear search, map, or tag filters to widen the list." : "Upload a .pbo file to get started")</MudText>
                </div>
            }
            else
            {
                <MudTable Items="_filteredMissions" Hover="true" Dense="true" Elevation="0"
                          Style="width:100%;">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Map</MudTh>
                        <MudTh>Size</MudTh>
                        <MudTh>Tags</MudTh>
                        <MudTh>Preset</MudTh>
                        <MudTh>In</MudTh>
                        <MudTh Style="width:150px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Color="Color.Secondary" />
                                <div>
                                    <MudText Typo="Typo.body2">@context.DisplayName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.FileName</MudText>
                                </div>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Map">
                            @if (!string.IsNullOrEmpty(context.MapName))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.MapName</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Size">@FormatSize(context.SizeBytes)</MudTd>
                        <MudTd DataLabel="Tags">
                            <div class="d-flex gap-1 flex-wrap">
                                @foreach (var assignment in context.TagAssignments)
                                {
                                    <MudChip T="MissionTag" Size="Size.Small" Variant="Variant.Filled"
                                             Color="@(_activeFilterTags.Any(t => t.Id == assignment.Tag!.Id) ? Color.Primary : Color.Default)"
                                             OnClick="() => AddFilterTag(assignment.Tag!)">
                                        #@assignment.Tag!.Name
                                    </MudChip>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenTagEditor(context))"
                                               Color="Color.Default" />
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Preset">
                            @if (context.ModPreset != null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@context.ModPreset.Name</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">None</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="In">
                            @{
                                var inCampaigns = CountCampaignsContaining(context.Id);
                                var inSets = CountSetsContaining(context.Id);
                            }
                            <div class="d-flex gap-1">
                                @if (inCampaigns > 0)
                                {
                                    <MudTooltip Text="@($"In {inCampaigns} campaign(s)")">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Text"
                                                 Icon="@Icons.Material.Filled.AutoStories">@inCampaigns</MudChip>
                                    </MudTooltip>
                                }
                                @if (inSets > 0)
                                {
                                    <MudTooltip Text="@($"In {inSets} collection(s)")">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text"
                                                 Icon="@Icons.Material.Filled.Collections">@inSets</MudChip>
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudMenu Icon="@Icons.Material.Filled.PlaylistAdd" Size="Size.Small"
                                     AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                                     Dense="true">
                                @if (_campaigns.Count == 0 && _sets.Count == 0)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.AutoStories"
                                                 OnClick="@(() => { _view = ViewCampaigns; _showCampaignDialog = true; })">
                                        Create a campaign…
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Collections"
                                                 OnClick="@(() => { _view = ViewCollections; _showSetDialog = true; })">
                                        Create a collection…
                                    </MudMenuItem>
                                }
                                @foreach (var campaign in _campaigns)
                                {
                                    var alreadyIn = campaign.CampaignMissions.Any(cm => cm.MissionId == context.Id);
                                    <MudMenuItem Icon="@Icons.Material.Filled.AutoStories"
                                                 Disabled="@alreadyIn"
                                                 OnClick="@(() => AddMissionToCampaignInline(campaign, context))">
                                        @campaign.Title @(alreadyIn ? " ✓" : "")
                                    </MudMenuItem>
                                }
                                @if (_campaigns.Count > 0 && _sets.Count > 0)
                                {
                                    <MudDivider />
                                }
                                @foreach (var set in _sets)
                                {
                                    var alreadyIn = set.SetMissions.Any(sm => sm.MissionId == context.Id);
                                    <MudMenuItem Icon="@Icons.Material.Filled.Collections"
                                                 Disabled="@alreadyIn"
                                                 OnClick="@(() => AddMissionToSetInline(set, context))">
                                        @set.Title @(alreadyIn ? " ✓" : "")
                                    </MudMenuItem>
                                }
                            </MudMenu>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="@(() => OpenMissionEditDialog(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => DeleteMission(context))" />
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            }
        </div>
    }

    @* ════════════════════ CAMPAIGNS VIEW ════════════════════ *@
    @if (_view == ViewCampaigns)
    {
        <div style="flex:1; min-height:0; overflow-y:auto;">
            @if (_campaigns.Count == 0)
            {
                <div class="d-flex flex-column align-center gap-2" style="padding:70px 0;">
                    <MudIcon Icon="@Icons.Material.Filled.AutoStories" Style="font-size:56px; color:var(--mud-palette-tertiary); opacity:.7;" />
                    <MudText Typo="Typo.h6">No campaigns yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        A campaign is an ordered playlist — mission 1 leads to mission 2. Perfect for multi-session operations.
                    </MudText>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Tertiary" Variant="Variant.Filled"
                               Class="mt-2" OnClick="@(() => _showCampaignDialog = true)">
                        Create your first campaign
                    </MudButton>
                </div>
            }
            else
            {
                <MudGrid Spacing="3">
                    @foreach (var campaign in _campaigns)
                    {
                        <MudItem xs="12" md="6" xl="4">
                            <MudCard Elevation="2" Style="height:100%; display:flex; flex-direction:column; border-top:3px solid var(--mud-palette-tertiary);">
                                <MudCardHeader Class="pb-0">
                                    <CardHeaderAvatar>
                                        <MudAvatar Color="Color.Tertiary" Variant="Variant.Outlined">
                                            <MudIcon Icon="@Icons.Material.Filled.AutoStories" />
                                        </MudAvatar>
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@campaign.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @campaign.CampaignMissions.Count mission(s), played in order
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="@(() => DeleteCampaign(campaign))" />
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent Style="flex:1;">
                                    @if (!string.IsNullOrEmpty(campaign.Description))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@campaign.Description</MudText>
                                    }
                                    @if (campaign.CampaignMissions.Count == 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Empty — add missions below or from the Library.</MudText>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @{
                                                var ordered = campaign.CampaignMissions.OrderBy(cm => cm.OrderIndex).ToList();
                                            }
                                            @for (var i = 0; i < ordered.Count; i++)
                                            {
                                                var cm = ordered[i];
                                                var index = i;
                                                <div class="d-flex align-center gap-2 pa-1 rounded"
                                                     style="border:1px solid var(--mud-palette-divider);">
                                                    <MudText Typo="Typo.body2" Color="Color.Tertiary" Style="min-width:22px; text-align:right; font-weight:700;">@(index + 1)</MudText>
                                                    <div style="flex:1; min-width:0;">
                                                        <MudText Typo="Typo.body2" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@cm.Mission?.DisplayName</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@cm.Mission?.MapName</MudText>
                                                    </div>
                                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small"
                                                                   Disabled="@(index == 0)"
                                                                   OnClick="@(() => MoveCampaignMission(campaign, index, -1))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"
                                                                   Disabled="@(index == ordered.Count - 1)"
                                                                   OnClick="@(() => MoveCampaignMission(campaign, index, +1))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                                                   OnClick="@(() => RemoveMissionFromCampaign(campaign.Id, cm.MissionId))" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </MudCardContent>
                                <MudCardActions Class="pt-0">
                                    <MudAutocomplete T="Mission" @key="@($"c{campaign.Id}-{campaign.CampaignMissions.Count}")"
                                                     Placeholder="Add mission…"
                                                     SearchFunc="@((s, ct) => SearchMissionsNotInCampaign(campaign, s, ct))"
                                                     ValueChanged="@(async m => await AddMissionToCampaignInline(campaign, m))"
                                                     ToStringFunc="@(m => m is not null ? $"{m.DisplayName} ({m.MapName})" : "")"
                                                     ResetValueOnEmptyText="false"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Add"
                                                     Style="width:100%;" />
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </div>
    }

    @* ════════════════════ COLLECTIONS VIEW ════════════════════ *@
    @if (_view == ViewCollections)
    {
        <div style="flex:1; min-height:0; overflow-y:auto;">
            @if (_sets.Count == 0)
            {
                <div class="d-flex flex-column align-center gap-2" style="padding:70px 0;">
                    <MudIcon Icon="@Icons.Material.Filled.Collections" Style="font-size:56px; color:var(--mud-palette-secondary); opacity:.7;" />
                    <MudText Typo="Typo.h6">No collections yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        A collection is an unordered group of related missions — a theme night, a map pack, a rotation pool.
                    </MudText>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Secondary" Variant="Variant.Filled"
                               Class="mt-2" OnClick="@(() => _showSetDialog = true)">
                        Create your first collection
                    </MudButton>
                </div>
            }
            else
            {
                <MudGrid Spacing="3">
                    @foreach (var set in _sets)
                    {
                        <MudItem xs="12" md="6" xl="4">
                            <MudCard Elevation="2" Style="height:100%; display:flex; flex-direction:column; border-top:3px solid var(--mud-palette-secondary);">
                                <MudCardHeader Class="pb-0">
                                    <CardHeaderAvatar>
                                        <MudAvatar Color="Color.Secondary" Variant="Variant.Outlined">
                                            <MudIcon Icon="@Icons.Material.Filled.Collections" />
                                        </MudAvatar>
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@set.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@set.SetMissions.Count mission(s)</MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="@(() => DeleteSet(set))" />
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent Style="flex:1;">
                                    @if (!string.IsNullOrEmpty(set.Description))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@set.Description</MudText>
                                    }
                                    @if (set.SetMissions.Count == 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Empty — add missions below or from the Library.</MudText>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-1 flex-wrap">
                                            @foreach (var sm in set.SetMissions)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                         Icon="@Icons.Material.Filled.Map"
                                                         OnClose="@(() => RemoveMissionFromSet(set.Id, sm.MissionId))">
                                                    @sm.Mission?.DisplayName
                                                </MudChip>
                                            }
                                        </div>
                                    }
                                </MudCardContent>
                                <MudCardActions Class="pt-0">
                                    <MudAutocomplete T="Mission" @key="@($"s{set.Id}-{set.SetMissions.Count}")"
                                                     Placeholder="Add mission…"
                                                     SearchFunc="@((s, ct) => SearchMissionsNotInSet(set, s, ct))"
                                                     ValueChanged="@(async m => await AddMissionToSetInline(set, m))"
                                                     ToStringFunc="@(m => m is not null ? $"{m.DisplayName} ({m.MapName})" : "")"
                                                     ResetValueOnEmptyText="false"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Add"
                                                     Style="width:100%;" />
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </div>
    }
</div>

@* ════════════ Upload Dialog ════════════ *@
<MudDialog @bind-Visible="_showUploadDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Upload Mission Files</MudText>
    </TitleContent>
    <DialogContent>
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" @ref="_fileUpload" FilesChanged="@OnUploadFilesSelected" Accept=".pbo">
            <CustomContent>
                <MudButton StartIcon="@Icons.Material.Filled.FileUpload"
                           Variant="Variant.Outlined"
                           OnClick="@OpenFilePicker">
                    Select .pbo files…
                </MudButton>
            </CustomContent>
        </MudFileUpload>

        @if (_uploadFiles.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="mt-2">@_uploadFiles.Count file(s) selected</MudText>
            <div class="mt-1" style="max-height:120px; overflow-y:auto;">
                @foreach (var file in _uploadFiles)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@file.Name</MudText>
                }
            </div>
        }

        @if (_isUploading)
        {
            <div class="mt-2">
                <MudProgressLinear Value="@_uploadProgress" Color="Color.Primary" Class="mb-1" />
                <MudText Typo="Typo.caption">@_uploadStatusText</MudText>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseUploadDialog" Disabled="@_isUploading">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="ConfirmUpload" Disabled="@(_uploadFiles.Count == 0 || _isUploading)">
            Upload @(_uploadFiles.Count > 0 ? _uploadFiles.Count.ToString() : "")
        </MudButton>
    </DialogActions>
</MudDialog>

@* ════════════ Campaign Creation Dialog ════════════ *@
<MudDialog @bind-Visible="_showCampaignDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Create Campaign</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newCampaignTitle" Label="Title" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_newCampaignDescription" Label="Description (optional)" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showCampaignDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="CreateCampaign"
                   Disabled="@(string.IsNullOrWhiteSpace(_newCampaignTitle))">
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@* ════════════ Collection Creation Dialog ════════════ *@
<MudDialog @bind-Visible="_showSetDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Create Collection</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newSetTitle" Label="Title" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_newSetDescription" Label="Description (optional)" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showSetDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="CreateSet"
                   Disabled="@(string.IsNullOrWhiteSpace(_newSetTitle))">
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@* ════════════ Mission Edit Dialog ════════════ *@
<MudDialog @bind-Visible="_showEditDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Mission</MudText>
    </TitleContent>
    <DialogContent>
        @if (_editingMission != null)
        {
            <MudTextField @bind-Value="_editDisplayName" Label="Display Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_editMapName" Label="Map Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudSelect T="int?" Label="Linked Preset" Variant="Variant.Outlined" Margin="Margin.Dense"
                       @bind-Value="_editPresetId" Clearable="true">
                @foreach (var preset in _availablePresets)
                {
                    <MudSelectItem T="int?" Value="@preset.Id">@preset.Name (@preset.Type)</MudSelectItem>
                }
            </MudSelect>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showEditDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveMissionEdit">Save</MudButton>
    </DialogActions>
</MudDialog>

@* ════════════ Tag Editor Dialog ════════════ *@
<MudDialog @bind-Visible="_showTagDialog"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Manage Tags</MudText>
    </TitleContent>
    <DialogContent>
        @if (_taggingMission != null)
        {
            <div class="d-flex flex-wrap gap-1 mb-2">
                @foreach (var assignment in _taggingMission.TagAssignments)
                {
                    <MudChip T="MissionTag" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                             OnClose="() => RemoveTagFromMission(assignment.Tag!)">
                        #@assignment.Tag!.Name
                    </MudChip>
                }
            </div>
            <MudAutocomplete T="MissionTag"
                             Label="Add tag…"
                             SearchFunc="@SearchAvailableTags"
                             ValueChanged="@OnTagSelected"
                             ToStringFunc="@(t => t is not null ? $"#{t.Name}" : "")"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             ResetValueOnEmptyText="false"
                             @bind-Text="_tagSearchText" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showTagDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public ServerInstance Instance { get; set; } = default!;

    private const string ViewLibrary = "library";
    private const string ViewCampaigns = "campaigns";
    private const string ViewCollections = "collections";
    private string _view = ViewLibrary;

    private List<Mission> _missions = [];
    private List<Mission> _filteredMissions = [];
    private List<Campaign> _campaigns = [];
    private List<Set> _sets = [];
    private List<MissionTag> _allTags = [];
    private List<MissionTag> _activeFilterTags = [];
    private List<ModPreset> _availablePresets = [];
    private string _searchQuery = "";
    private string? _activeMapFilter;
    private bool _loadingMissions;

    // Upload
    private bool _showUploadDialog;
    private List<IBrowserFile> _uploadFiles = [];
    private bool _isUploading;
    private double _uploadProgress;
    private string _uploadStatusText = "";
    private MudFileUpload<IReadOnlyList<IBrowserFile>>? _fileUpload;

    // Campaign
    private bool _showCampaignDialog;
    private string _newCampaignTitle = "";
    private string _newCampaignDescription = "";

    // Collection (Set)
    private bool _showSetDialog;
    private string _newSetTitle = "";
    private string _newSetDescription = "";

    // Edit
    private bool _showEditDialog;
    private Mission? _editingMission;
    private string _editDisplayName = "";
    private string _editMapName = "";
    private int? _editPresetId;

    // Tags
    private bool _showTagDialog;
    private Mission? _taggingMission;
    private string _tagSearchText = "";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAll();
    }

    private async Task RefreshAll()
    {
        _loadingMissions = true;
        StateHasChanged();

        try
        {
            _missions = (await MissionService.GetMissionsForInstanceAsync(Instance.Id)).ToList();
            _campaigns = (await MissionService.GetCampaignsForInstanceAsync(Instance.Id)).ToList();
            _sets = (await MissionService.GetSetsForInstanceAsync(Instance.Id)).ToList();
            _allTags = (await MissionService.GetTagsForInstanceAsync(Instance.Id)).ToList();
            ApplyFilter();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed to load missions: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed to load missions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingMissions = false;
            StateHasChanged();
        }
    }

    private IReadOnlyList<string> AvailableMaps => _missions
        .Select(m => m.MapName)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .GroupBy(m => m, StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(g => g.Count())
        .ThenBy(g => g.Key)
        .Select(g => g.Key)
        .ToList();

    private bool HasMissionFilters =>
        !string.IsNullOrWhiteSpace(_searchQuery) ||
        !string.IsNullOrWhiteSpace(_activeMapFilter) ||
        _activeFilterTags.Count > 0;

    private int CountCampaignsContaining(int missionId)
        => _campaigns.Count(c => c.CampaignMissions.Any(cm => cm.MissionId == missionId));

    private int CountSetsContaining(int missionId)
        => _sets.Count(s => s.SetMissions.Any(sm => sm.MissionId == missionId));

    private void OnMissionSearchChanged(string value)
    {
        _searchQuery = value;
        ApplyFilter();
    }

    private void SetMapFilter(string? map)
    {
        _activeMapFilter = string.Equals(_activeMapFilter, map, StringComparison.OrdinalIgnoreCase) ? null : map;
        ApplyFilter();
    }

    private int CountMissionsOnMap(string map)
    {
        return _missions.Count(m => string.Equals(m.MapName, map, StringComparison.OrdinalIgnoreCase));
    }

    private void ApplyFilter()
    {
        var filtered = _missions.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.Trim();

            // Parse #tag searches
            var tagMatches = System.Text.RegularExpressions.Regex.Matches(q, @"#(\S+)");
            foreach (System.Text.RegularExpressions.Match match in tagMatches)
            {
                var tagName = match.Groups[1].Value;
                var tag = _allTags.FirstOrDefault(t => t.Name.Equals(tagName, StringComparison.OrdinalIgnoreCase));
                if (tag != null && !_activeFilterTags.Any(t => t.Id == tag.Id))
                    _activeFilterTags.Add(tag);

                q = q.Replace(match.Value, "").Trim();
            }

            if (!string.IsNullOrWhiteSpace(q))
            {
                filtered = filtered.Where(m =>
                    m.DisplayName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    m.FileName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    m.MapName.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
        }

        if (!string.IsNullOrWhiteSpace(_activeMapFilter))
        {
            filtered = filtered.Where(m => string.Equals(m.MapName, _activeMapFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (_activeFilterTags.Count > 0)
        {
            var tagIds = _activeFilterTags.Select(t => t.Id).ToHashSet();
            filtered = filtered.Where(m => m.TagAssignments.Any(a => tagIds.Contains(a.MissionTagId)));
        }

        _filteredMissions = filtered.OrderByDescending(m => m.UploadedAt).ToList();
        StateHasChanged();
    }

    private void AddFilterTag(MissionTag tag)
    {
        if (!_activeFilterTags.Any(t => t.Id == tag.Id))
        {
            _activeFilterTags.Add(tag);
            ApplyFilter();
        }
    }

    private void RemoveFilterTag(MissionTag tag)
    {
        _activeFilterTags.RemoveAll(t => t.Id == tag.Id);
        ApplyFilter();
    }

    // ── Upload ────────────────────────────────────────────────────────────────

    private void OpenUploadDialog() { _showUploadDialog = true; _uploadFiles = []; }

    private async Task OpenFilePicker()
    {
        if (_fileUpload != null)
            await _fileUpload.OpenFilePickerAsync();
    }

    private void CloseUploadDialog()
    {
        _showUploadDialog = false;
        _uploadFiles = [];
        _uploadProgress = 0;
        _uploadStatusText = "";
    }

    private void OnUploadFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        _uploadFiles = files.Where(f => f.Name.EndsWith(".pbo", StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task ConfirmUpload()
    {
        if (_uploadFiles.Count == 0) return;

        _isUploading = true;
        _uploadProgress = 0;
        int uploaded = 0;
        int failed = 0;

        for (int i = 0; i < _uploadFiles.Count; i++)
        {
            var file = _uploadFiles[i];
            _uploadStatusText = $"Uploading {i + 1} of {_uploadFiles.Count}: {file.Name}";
            _uploadProgress = (double)i / _uploadFiles.Count * 100;
            StateHasChanged();

            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
                await MissionService.UploadMissionAsync(Instance.Id, file.Name, stream);
                uploaded++;
            }
            catch (InvalidOperationException ex)
            {
                failed++;
                Snackbar.Add($"Failed: {file.Name} — {ex.Message}", Severity.Error);
            }
            catch (IOException ex)
            {
                failed++;
                Snackbar.Add($"Failed: {file.Name}: {ex.Message}", Severity.Error);
            }
            catch (UnauthorizedAccessException ex)
            {
                failed++;
                Snackbar.Add($"Failed: {file.Name}: {ex.Message}", Severity.Error);
            }
        }

        _uploadProgress = 100;
        _uploadStatusText = uploaded > 0
            ? $"Uploaded {uploaded} file(s)" + (failed > 0 ? $", {failed} failed" : "")
            : "Upload failed";
        StateHasChanged();

        if (uploaded > 0)
        {
            Snackbar.Add($"Uploaded {uploaded} mission(s)", Severity.Success);
            await RefreshAll();
        }

        CloseUploadDialog();
        _isUploading = false;
        StateHasChanged();
    }

    // ── Delete ────────────────────────────────────────────────────────────────

    private async Task DeleteMission(Mission mission)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete mission '{mission.DisplayName}'? The .pbo file will be permanently removed.");
        if (!confirmed) return;

        try
        {
            await MissionService.DeleteMissionAsync(mission.Id);
            Snackbar.Add($"Deleted {mission.DisplayName}", Severity.Success);
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        catch (IOException ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

    // ── Campaigns ─────────────────────────────────────────────────────────────

    private async Task<IEnumerable<Mission>> SearchMissionsNotInCampaign(Campaign campaign, string search, CancellationToken ct)
    {
        await Task.CompletedTask;
        var assigned = campaign.CampaignMissions.Select(cm => cm.MissionId).ToHashSet();
        return _missions.Where(m =>
            !assigned.Contains(m.Id) &&
            (string.IsNullOrEmpty(search) ||
             m.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
             m.FileName.Contains(search, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task AddMissionToCampaignInline(Campaign campaign, Mission? mission)
    {
        if (mission == null) return;
        if (campaign.CampaignMissions.Any(cm => cm.MissionId == mission.Id)) return;
        try
        {
            var nextOrder = campaign.CampaignMissions.Count;
            await MissionService.AddMissionToCampaignAsync(campaign.Id, mission.Id, nextOrder);
            Snackbar.Add($"Added '{mission.DisplayName}' to '{campaign.Title}'", Severity.Success);
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task MoveCampaignMission(Campaign campaign, int index, int delta)
    {
        var ordered = campaign.CampaignMissions.OrderBy(cm => cm.OrderIndex).Select(cm => cm.MissionId).ToList();
        var target = index + delta;
        if (target < 0 || target >= ordered.Count) return;

        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);

        try
        {
            await MissionService.ReorderCampaignMissionsAsync(campaign.Id, ordered);
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Reorder failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Reorder failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveMissionFromCampaign(int campaignId, int missionId)
    {
        try
        {
            await MissionService.RemoveMissionFromCampaignAsync(campaignId, missionId);
            Snackbar.Add("Mission removed from campaign", Severity.Success);
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CreateCampaign()
    {
        if (string.IsNullOrWhiteSpace(_newCampaignTitle)) return;
        if (Instance.Id <= 0)
        {
            Snackbar.Add("Save the server first, then create campaigns.", Severity.Warning);
            return;
        }

        try
        {
            var campaign = new Campaign
            {
                ServerInstanceId = Instance.Id,
                Title = _newCampaignTitle.Trim(),
                Description = string.IsNullOrWhiteSpace(_newCampaignDescription) ? null : _newCampaignDescription.Trim()
            };
            await MissionService.CreateCampaignAsync(campaign);
            Snackbar.Add($"Campaign '{campaign.Title}' created", Severity.Success);
            _showCampaignDialog = false;
            _newCampaignTitle = "";
            _newCampaignDescription = "";
            _view = ViewCampaigns;
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed to create campaign: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed to create campaign: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteCampaign(Campaign campaign)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete campaign '{campaign.Title}'?");
        if (!confirmed) return;

        try
        {
            await MissionService.DeleteCampaignAsync(campaign.Id);
            Snackbar.Add($"Campaign '{campaign.Title}' deleted", Severity.Success);
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

    // ── Collections (Sets) ────────────────────────────────────────────────────

    private async Task<IEnumerable<Mission>> SearchMissionsNotInSet(Set set, string search, CancellationToken ct)
    {
        await Task.CompletedTask;
        var assigned = set.SetMissions.Select(sm => sm.MissionId).ToHashSet();
        return _missions.Where(m =>
            !assigned.Contains(m.Id) &&
            (string.IsNullOrEmpty(search) ||
             m.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
             m.FileName.Contains(search, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task AddMissionToSetInline(Set set, Mission? mission)
    {
        if (mission == null) return;
        if (set.SetMissions.Any(sm => sm.MissionId == mission.Id)) return;
        try
        {
            await MissionService.AddMissionToSetAsync(set.Id, mission.Id);
            Snackbar.Add($"Added '{mission.DisplayName}' to '{set.Title}'", Severity.Success);
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveMissionFromSet(int setId, int missionId)
    {
        try
        {
            await MissionService.RemoveMissionFromSetAsync(setId, missionId);
            Snackbar.Add("Mission removed from collection", Severity.Success);
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CreateSet()
    {
        if (string.IsNullOrWhiteSpace(_newSetTitle)) return;
        if (Instance.Id <= 0)
        {
            Snackbar.Add("Save the server first, then create collections.", Severity.Warning);
            return;
        }

        try
        {
            var set = new Set
            {
                ServerInstanceId = Instance.Id,
                Title = _newSetTitle.Trim(),
                Description = string.IsNullOrWhiteSpace(_newSetDescription) ? null : _newSetDescription.Trim()
            };
            await MissionService.CreateSetAsync(set);
            Snackbar.Add($"Collection '{set.Title}' created", Severity.Success);
            _showSetDialog = false;
            _newSetTitle = "";
            _newSetDescription = "";
            _view = ViewCollections;
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed to create collection: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed to create collection: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteSet(Set set)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete collection '{set.Title}'?");
        if (!confirmed) return;

        try
        {
            await MissionService.DeleteSetAsync(set.Id);
            Snackbar.Add($"Collection '{set.Title}' deleted", Severity.Success);
