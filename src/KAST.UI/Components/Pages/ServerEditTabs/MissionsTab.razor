        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

    // ── Edit Mission ──────────────────────────────────────────────────────────

    private async Task OpenMissionEditDialog(Mission mission)
    {
        try
        {
            _availablePresets = (await ModPresetService.GetPresetsForInstanceAsync(Instance.Id)).ToList();
        }
        catch (InvalidOperationException)
        {
            _availablePresets = [];
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            _availablePresets = [];
        }

        _editingMission = mission;
        _editDisplayName = mission.DisplayName;
        _editMapName = mission.MapName;
        _editPresetId = mission.ModPresetId;
        _showEditDialog = true;
    }

    private async Task SaveMissionEdit()
    {
        if (_editingMission == null) return;

        try
        {
            _editingMission.DisplayName = _editDisplayName;
            _editingMission.MapName = _editMapName;
            _editingMission.ModPresetId = _editPresetId;
            await MissionService.UpdateMissionAsync(_editingMission);
            Snackbar.Add("Mission updated", Severity.Success);
            _showEditDialog = false;
            await RefreshAll();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Update failed: {ex.Message}", Severity.Error);
        }
    }

    // ── Tags ──────────────────────────────────────────────────────────────────

    private void OpenTagEditor(Mission mission)
    {
        _taggingMission = mission;
        _showTagDialog = true;
    }

    private async Task<IEnumerable<MissionTag>> SearchAvailableTags(string search, CancellationToken ct)
    {
        await Task.CompletedTask;
        if (_taggingMission == null) return [];
        var assignedIds = _taggingMission.TagAssignments.Select(a => a.MissionTagId).ToHashSet();
        return _allTags.Where(t => !assignedIds.Contains(t.Id) &&
                                   (string.IsNullOrEmpty(search) || t.Name.Contains(search, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task OnTagSelected(MissionTag? tag)
    {
        if (_taggingMission == null) return;

        if (tag != null)
        {
            // Existing tag selected from dropdown
            await AssignTagToMission(tag);
        }
        else if (!string.IsNullOrWhiteSpace(_tagSearchText))
        {
            // No match found — create the tag on-the-fly
            var cleanName = _tagSearchText.TrimStart('#').Trim();
            if (!string.IsNullOrWhiteSpace(cleanName))
            {
                try
                {
                    var newTag = await MissionService.CreateTagAsync(Instance.Id, cleanName);
                    if (!_allTags.Any(t => t.Id == newTag.Id))
                        _allTags.Add(newTag);
                    await AssignTagToMission(newTag);
                    _tagSearchText = "";
                }
                catch (InvalidOperationException ex)
                {
                    Snackbar.Add($"Failed to create tag: {ex.Message}", Severity.Error);
                }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed to create tag: {ex.Message}", Severity.Error);
        }
            }
        }
    }

    private async Task AssignTagToMission(MissionTag tag)
    {
        if (_taggingMission == null) return;
        try
        {
            await MissionService.AssignTagAsync(_taggingMission.Id, tag.Id);
            _taggingMission = await MissionService.GetMissionByIdAsync(_taggingMission.Id);
            await RefreshAll();
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed to add tag: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed to add tag: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveTagFromMission(MissionTag tag)
    {
        if (_taggingMission == null) return;
        try
        {
            await MissionService.RemoveTagAsync(_taggingMission.Id, tag.Id);
            _taggingMission = await MissionService.GetMissionByIdAsync(_taggingMission.Id);
            await RefreshAll();
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed to remove tag: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Failed to remove tag: {ex.Message}", Severity.Error);
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }
}
