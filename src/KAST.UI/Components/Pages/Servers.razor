@page "/servers"
@attribute [Authorize]
@implements IDisposable
@using KAST.Infrastructure.Services.Content
@inject IServerInstanceService ServerService
@inject IOutputSanitizer OutputSanitizer
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ContentProgressTracker ContentProgress
@inject MonitoringSnapshotService Snapshots
@inject IJSRuntime JS

<PageTitle>Servers · CASTER</PageTitle>

<PageHeader Title="Servers" Subtitle="Arma 3 dedicated server instances on this host.">
    <Actions>
        <MudFileUpload T="IBrowserFile" Accept=".json" FilesChanged="OnImportFileSelected">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.FileUpload">Import</MudButton>
            </CustomContent>
        </MudFileUpload>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" Href="servers/new">
            New server
        </MudButton>
    </Actions>
</PageHeader>

<SectionCard Flush="true">
    @if (_instances.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Dns" Title="No servers yet"
                    Description="Create a server instance, install the Arma 3 server files and assign mods.">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" Href="servers/new">
                New server
            </MudButton>
        </EmptyState>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="k-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th class="k-num-col">Port</th>
                    <th class="k-num-col">Players</th>
                    <th class="k-num-col">Mods</th>
                    <th class="k-num-col">HC</th>
                    <th>Uptime</th>
                    <th class="k-actions-col"><span class="k-sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var instance in _instances)
                {
                    var id = instance.Id;
                    <tr class="k-row-link" @onclick="@(() => Nav.NavigateTo($"servers/{id}"))">
                        <td>
                            <div class="k-cell-title">@instance.Name</div>
                            @if (!instance.InstalledAt.HasValue && instance.Status != ServerInstanceStatus.Downloading)
                            {
                                <div class="k-cell-sub">Server files not installed</div>
                            }
                        </td>
                        <td><StatusBadge Status="instance.Status" /></td>
                        <td class="k-num-col k-mono">@instance.Port</td>
                        <td class="k-num-col">@GetPlayers(instance)</td>
                        <td class="k-num-col">@instance.Mods.Count</td>
                        <td class="k-num-col">@instance.HeadlessClientCount</td>
                        <td class="k-cell-muted">@(instance.Status == ServerInstanceStatus.Running ? UiHelpers.FormatUptime(instance.StartedAt) : "—")</td>
                        <td class="k-actions-col" @onclick:stopPropagation="true">
                            @if (instance.Status == ServerInstanceStatus.Running)
                            {
                                <MudTooltip Text="Restart"><MudIconButton Icon="@Icons.Material.Outlined.RestartAlt" Size="Size.Small" aria-label="Restart" OnClick="@(() => RestartInstance(instance))" /></MudTooltip>
                                <MudTooltip Text="Stop"><MudIconButton Icon="@Icons.Material.Outlined.Stop" Size="Size.Small" aria-label="Stop" OnClick="@(() => StopInstance(instance))" /></MudTooltip>
                            }
                            else if (instance.Status is ServerInstanceStatus.Stopped or ServerInstanceStatus.Crashed)
                            {
                                <MudTooltip Text="@(instance.InstalledAt.HasValue ? "Start" : "Install the server files first")">
                                    <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Size="Size.Small" aria-label="Start"
                                                   Disabled="@(!instance.InstalledAt.HasValue)" OnClick="@(() => StartInstance(id))" />
                                </MudTooltip>
                            }
                            <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" Dense="true" aria-label="More actions"
                                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                <MudMenuItem Icon="@Icons.Material.Outlined.FileDownload" OnClick="@(() => ExportInstance(id))">Export</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="@(() => PromptDelete(instance))">Delete…</MudMenuItem>
                            </MudMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</SectionCard>

<MudDialog @bind-Visible="_deleteDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.ExtraSmall }">
    <TitleContent>Delete server</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">
            Delete <strong>@(_instancePendingDelete?.Name ?? "this server")</strong> from CASTER? A running server is stopped first.
        </MudText>
        <MudCheckBox @bind-Value="_deleteInstanceFiles" Label="Also delete the server files from disk" Color="Color.Error" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CancelDelete">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@(() => DeleteInstance(_instancePendingDelete!.Id))">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<ServerInstance> _instances = [];
    private ServerInstance? _instancePendingDelete;
    private bool _deleteDialogVisible;
    private bool _deleteInstanceFiles;

    [Inject] private IDialogService Dialogs { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await RefreshInstances();
        Snapshots.Changed += OnSnapshotChanged;
    }

    /// <summary>Re-query when the 5 s metrics snapshot reports a status this list does not show.</summary>
    private void OnSnapshotChanged()
    {
        var live = Snapshots.Current.Instances.ToDictionary(i => i.Id, i => i.Status);
        var stale = _instances.Any(i => live.TryGetValue(i.Id, out var s)
                ? s != i.Status
                : i.Status != ServerInstanceStatus.Stopped);
        if (stale)
            _ = InvokeAsync(async () =>
            {
                try { await RefreshInstances(); StateHasChanged(); }
                catch (Exception) { /* next snapshot retries */ }
            });
        else
            _ = InvokeAsync(StateHasChanged); // player counts / uptime
    }

    private string GetPlayers(ServerInstance instance)
    {
        if (instance.Status != ServerInstanceStatus.Running)
            return "—";
        var metrics = Snapshots.Current.InstanceMetrics.FirstOrDefault(m => m.ServerInstanceId == instance.Id);
        if (metrics is null)
            return "—";
        return metrics.MaxPlayers > 0 ? $"{metrics.PlayerCount}/{metrics.MaxPlayers}" : $"{metrics.PlayerCount}";
    }

    public void Dispose() => Snapshots.Changed -= OnSnapshotChanged;

    private async Task RefreshInstances()
        => _instances = await ServerService.GetAllInstancesAsync();

    private void PromptDelete(ServerInstance instance)
    {
        _instancePendingDelete = instance;
        _deleteInstanceFiles = false;
        _deleteDialogVisible = true;
    }

    private void CancelDelete()
    {
        _deleteDialogVisible = false;
        _instancePendingDelete = null;
        _deleteInstanceFiles = false;
    }

    private async Task StartInstance(int id)
    {
        try { await ServerService.StartInstanceAsync(id); Nav.NavigateTo($"/servers/{id}"); }
        catch (InvalidOperationException ex) { Snackbar.Add($"Failed to start: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); await RefreshInstances(); }
        catch (System.ComponentModel.Win32Exception ex) { Snackbar.Add($"Failed to start: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); await RefreshInstances(); }
    }

    private async Task StopInstance(ServerInstance instance)
    {
        var id = instance.Id;
        if (!await Dialogs.ConfirmAsync("Stop server", $"Stop {instance.Name}? Connected players are disconnected.", "Stop", destructive: true))
            return;
        try { await ServerService.StopInstanceAsync(id); Snackbar.Add("Server stopped", Severity.Success); }
        catch (InvalidOperationException ex) { Snackbar.Add($"Failed to stop: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        catch (System.ComponentModel.Win32Exception ex) { Snackbar.Add($"Failed to stop: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        finally { await RefreshInstances(); }
    }

    private async Task RestartInstance(ServerInstance instance)
    {
        var id = instance.Id;
        if (!await Dialogs.ConfirmAsync("Restart server", $"Restart {instance.Name}? Connected players are disconnected.", "Restart"))
            return;
        try { await ServerService.RestartInstanceAsync(id); Snackbar.Add("Server restarted", Severity.Success); }
        catch (InvalidOperationException ex) { Snackbar.Add($"Failed to restart: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        catch (System.ComponentModel.Win32Exception ex) { Snackbar.Add($"Failed to restart: {OutputSanitizer.SanitizeException(ex)}", Severity.Error); }
        finally { await RefreshInstances(); }
    }

    private async Task DeleteInstance(int id)
    {
        await ServerService.DeleteInstanceAsync(id, _deleteInstanceFiles);
        _deleteDialogVisible = false;
        _instancePendingDelete = null;
        _deleteInstanceFiles = false;
        await RefreshInstances();
        Snackbar.Add("Instance deleted", Severity.Success);
    }

    private async Task ExportInstance(int id)
    {
        try
        {
            var instance = await ServerService.GetInstanceByIdAsync(id);
            if (instance is null)
            {
                Snackbar.Add("Instance not found", Severity.Error);
                return;
            }

            var json = System.Text.Json.JsonSerializer.Serialize(instance, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles
            });

            var filename = $"{instance.Name.Replace(" ", "_")}_{instance.Id}.json";
            await JS.InvokeVoidAsync("KAST.downloadFile", filename, json);
            Snackbar.Add($"Exported {instance.Name}", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        catch (System.Text.Json.JsonException ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnImportFileSelected(IBrowserFile file)
    {
        if (file is null) return;
        try
        {

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var options = new System.Text.Json.JsonSerializerOptions
            {
                ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles,
                PropertyNameCaseInsensitive = true
            };
            var instance = System.Text.Json.JsonSerializer.Deserialize<ServerInstance>(json, options);
            if (instance is null)
            {
                Snackbar.Add("Failed to parse instance file", Severity.Error);
                return;
            }

            // Reset fields for a fresh import
            instance.Id = 0;
            instance.Status = ServerInstanceStatus.Stopped;
            instance.ProcessId = null;
            instance.StartedAt = null;
            instance.InstalledAt = null;
            instance.InstalledBuildId = null;
            instance.LastModified = null;

            // Clear relational IDs and rewire navigations so EF creates new child rows
            foreach (var mod in instance.Mods)
            {
                mod.ServerInstanceId = 0;
                mod.ServerInstance = instance;
            }
            foreach (var hc in instance.HeadlessClients)
            {
                hc.Id = 0;
                hc.ServerInstanceId = 0;
                hc.ServerInstance = instance;
                hc.Status = ServerInstanceStatus.Stopped;
                hc.ProcessId = null;
                hc.StartedAt = null;
            }

            await ServerService.CreateInstanceAsync(instance);
            await RefreshInstances();
            Snackbar.Add("Instance imported successfully", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        catch (IOException ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        catch (System.Text.Json.JsonException ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
    }

}
