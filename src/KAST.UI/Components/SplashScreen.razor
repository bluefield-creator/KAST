@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Security.Cryptography
@inject ProtectedLocalStorage Storage

@if (_visible)
{
    <div id="kast-splash" aria-hidden="true" class="@_cssClass">
      <div class="ks-forge">
        <div class="ks-spark" style="left:52px;top:96px;--x:14px;--d:1.1s;--t:.00s;--c:#CFCEF0"></div>
        <div class="ks-spark" style="left:70px;top:84px;--x:10px;--d:1.4s;--t:.28s;--s:5px;--c:#EAE9FA"></div>
        <div class="ks-spark" style="left:60px;top:110px;--x:17px;--d:1.0s;--t:.55s;--s:3px;--c:#5A57A8"></div>
        <div class="ks-spark" style="left:40px;top:100px;--x:-8px;--d:1.3s;--t:.82s;--c:#ffffff"></div>
        <div class="ks-spark" style="left:88px;top:92px;--x:20px;--d:1.5s;--t:.16s;--s:3px;--c:#C89A5E"></div>
        <div class="ks-spark" style="left:190px;top:34px;--x:11px;--d:1.2s;--t:.44s;--s:3px;--c:#CFCEF0"></div>
        <div class="ks-spark" style="left:286px;top:44px;--x:-6px;--d:1.0s;--t:.72s;--s:4px;--c:#EBCB95"></div>

        <div class="ks-word">
          <div class="ks-k-wrap">
            <img class="ks-k-base" src="caster-wordmark.svg" alt="CASTER" draggable="false" />
            <img class="ks-k-fill" src="caster-wordmark.svg" alt="" draggable="false" />
          </div>
        </div>
      </div>

      <div class="ks-tagline">Arma Server Tool — Enterprise Edition</div>
      <div class="ks-dots">
        <div class="ks-dot"></div>
        <div class="ks-dot"></div>
        <div class="ks-dot"></div>
      </div>
    </div>
}

@code {
    private const string TimestampKey = "kast_splash_timestamp";
    private static readonly TimeSpan SuppressWindow = TimeSpan.FromSeconds(10);

    private bool _visible = true;
    private string _cssClass = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Check whether the splash was already shown recently (e.g. during a
        // SignalR reconnect that created a fresh circuit).  If the stored
        // timestamp is within the suppression window we hide the splash
        // immediately so the user doesn't sit through the full animation again.
        var skipAnimation = false;
        try
        {
            var result = await Storage.GetAsync<string>(TimestampKey);
            if (result.Success
                && !string.IsNullOrEmpty(result.Value)
                && DateTime.TryParse(result.Value, null, System.Globalization.DateTimeStyles.RoundtripKind, out var ts))
            {
                skipAnimation = DateTime.UtcNow - ts < SuppressWindow;
            }
        }
        catch (InvalidOperationException)
        {
            // Storage may be unavailable during pre-rendering; default to
            // playing the animation (safe fallback).
            skipAnimation = false;
        }
        catch (Microsoft.JSInterop.JSException)
        {
            skipAnimation = false;
        }
        catch (CryptographicException)
        {
            await TryDeleteTimestampAsync();
            skipAnimation = false;
        }

        if (skipAnimation)
        {
            _visible = false;
            StateHasChanged();
            return;
        }

        // Persist the current timestamp before starting the animation so that
        // a quick reconnect that follows will see a recent value and skip.
        try
        {
            await Storage.SetAsync(TimestampKey, DateTime.UtcNow.ToString("O"));
        }
        catch (InvalidOperationException)
        {
            // Non-critical — worst case the animation replays on reconnect.
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // Non-critical - worst case the animation replays on reconnect.
        }
        catch (CryptographicException)
        {
            await TryDeleteTimestampAsync();
        }

        // ── Original animation sequence (unchanged) ─────────────────────────
        await Task.Delay(1000);

        _cssClass = "ks-ready";
        StateHasChanged();

        await Task.Delay(620);

        _cssClass = "ks-ready ks-out";
        StateHasChanged();

        await Task.Delay(620);

        _visible = false;
        StateHasChanged();
    }

    private async Task TryDeleteTimestampAsync()
    {
        try
        {
            await Storage.DeleteAsync(TimestampKey);
        }
        catch (InvalidOperationException) { }
        catch (Microsoft.JSInterop.JSException) { }
        catch (CryptographicException) { }
    }
}
